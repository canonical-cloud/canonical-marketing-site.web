---
interface Props {
  partyType: 'individual' | 'organization';
}

const { partyType } = Astro.props;
const isOrganization = partyType === 'organization';
const formAction = isOrganization
  ? 'https://org.canonical.plus/api/pre-interest'
  : 'https://user.canonical.plus/api/pre-interest';
const emailId = `${partyType}-email`;
const organizationId = `${partyType}-organization`;
const referralId = `${partyType}-referral`;
const consentId = `${partyType}-contact-consent`;
const interests = [
  ['readiness_assessment', 'General readiness assessment'],
  ['soc2', 'SOC 2'],
  ['iso_27001', 'ISO 27001'],
  ['hipaa', 'HIPAA'],
  ['pci_dss_4', 'PCI DSS 4'],
  ['fedramp', 'FedRAMP'],
  ['nist', 'NIST'],
  ['gdpr', 'GDPR'],
  ['cmmc', 'CMMC'],
];
---

<form
  class="pre-interest-form card"
  method="post"
  action={formAction}
  accept-charset="UTF-8"
  data-pre-interest-form={partyType}
>
  <input type="hidden" name="partyType" value={partyType} />
  <input type="hidden" name="consentRevision" value="pre-interest-v1" />

  <div class="form-field">
    <label for={emailId}>Work email</label>
    <input
      id={emailId}
      name="email"
      type="email"
      inputmode="email"
      autocomplete="email"
      maxlength="320"
      required
      aria-describedby={`${emailId}-help`}
    />
    <p class="form-help" id={`${emailId}-help`}>
      Used only to follow up about the readiness services selected below.
    </p>
  </div>

  {isOrganization && (
    <div class="form-field">
      <label for={organizationId}>Organization name</label>
      <input
        id={organizationId}
        name="organizationName"
        type="text"
        autocomplete="organization"
        maxlength="200"
        required
      />
    </div>
  )}

  <fieldset class="form-field">
    <legend>What are you interested in?</legend>
    <p class="form-help" id={`${partyType}-interests-help`}>
      Select one or more. The server rejects an empty selection.
    </p>
    <div class="interest-grid" aria-describedby={`${partyType}-interests-help`}>
      {interests.map(([value, label]) => (
        <label class="interest-option">
          <input type="checkbox" name="interestAreas" value={value} />
          <span>{label}</span>
        </label>
      ))}
    </div>
  </fieldset>

  <div class="form-field">
    <label for={referralId}>Referral code <span class="form-optional">(optional)</span></label>
    <input
      id={referralId}
      name="referralCode"
      type="text"
      maxlength="64"
      pattern="[A-Za-z0-9][A-Za-z0-9._-]{0,63}"
      autocomplete="off"
      aria-describedby={`${referralId}-help`}
    />
    <p class="form-help" id={`${referralId}-help`}>
      Use only the short code you received, not a URL or message.
    </p>
  </div>

  <div class="consent-row">
    <input
      id={consentId}
      name="contactConsent"
      type="checkbox"
      value="accepted"
      required
    />
    <label for={consentId}>
      I agree that Canonical Plus may store this registration and contact me
      about the readiness services I selected. This consent is separate from
      account creation, marketing subscriptions, and any later quote request.
    </label>
  </div>

  <button class="btn btn--primary btn--large" type="submit">
    Register interest
  </button>

  <p class="boundary-note">
    Registering interest does not create an account, session, quote, role,
    grant, entitlement, audit opinion, or certification. After acceptance,
    the service may offer a separate link to start a readiness quote.
  </p>
</form>

<style>
  .pre-interest-form {
    display: grid;
    gap: var(--space-lg);
    max-width: 48rem;
    margin: 0 auto;
  }

  .form-field {
    display: grid;
    gap: var(--space-xs);
    min-width: 0;
  }

  .form-field label,
  .form-field legend {
    color: var(--av-text-primary);
    font-weight: 700;
  }

  .form-field input[type='email'],
  .form-field input[type='text'] {
    width: 100%;
    min-height: 3rem;
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--av-border-hover);
    border-radius: var(--radius-sm);
    background: var(--av-surface);
    color: var(--av-text-primary);
  }

  .form-field input:focus-visible,
  .consent-row input:focus-visible,
  .interest-option input:focus-visible {
    outline: 3px solid var(--av-teal);
    outline-offset: 3px;
  }

  .form-help,
  .form-optional {
    color: var(--av-text-secondary);
    font-size: 0.9rem;
  }

  .interest-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: var(--space-sm);
  }

  .interest-option,
  .consent-row {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
  }

  .interest-option {
    min-height: 3rem;
    padding: 0.75rem;
    border: 1px solid var(--av-border);
    border-radius: var(--radius-sm);
  }

  .interest-option input,
  .consent-row input {
    width: 1.25rem;
    height: 1.25rem;
    margin-top: 0.1rem;
    flex: 0 0 auto;
  }

  .consent-row {
    padding: var(--space-md);
    border-left: 3px solid var(--av-teal);
    background: var(--av-surface);
  }

  .boundary-note {
    margin: 0;
  }
</style>
