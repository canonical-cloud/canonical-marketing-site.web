---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
import '../styles/marketing-pages.css';

const baseNoSlash = import.meta.env.BASE_URL.replace(/\/+$/, '');
const pricingHref = `${baseNoSlash}/pricing/`;
const quoteHref = `${baseNoSlash}/quote/`;
const contactScriptHref = `${baseNoSlash}/contact-form.js`;
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL || '';
---

<BaseLayout
  title="Contact Canonical Plus"
  description="Contact Canonical Plus about compliance readiness, remediation, pricing, payment plans, and pre-audit preparation."
>
  <section class="page-hero section--hero bg-grid bg-radial">
    <div class="container page-hero__grid">
      <div class="page-hero__copy">
        <span class="badge">Contact Canonical Plus</span>
        <p class="page-hero__eyebrow">hello@canonical.plus</p>
        <h1 class="page-hero__title hero__title">
          Talk through your readiness plan.
          <span class="gradient-text">We’ll help scope the next step.</span>
        </h1>
        <p class="page-hero__subtitle">
          Tell us what framework, customer requirement, deadline, or technical gap you are working through.
          We can help scope readiness, remediation, evidence preparation, and independent-audit coordination.
        </p>
        <div class="page-hero__actions">
          <a class="btn btn--primary btn--large" href="mailto:hello@canonical.plus">hello@canonical.plus</a>
          <a class="btn btn--secondary btn--large" href={quoteHref}>Build a quote</a>
        </div>
      </div>
      <aside class="page-hero__panel">
        <h2>Useful context</h2>
        <ul class="check-list">
          <li>Frameworks or customer requirements</li>
          <li>Cloud and application footprint</li>
          <li>Known control, evidence, or remediation gaps</li>
          <li>Target date and any independent review already scheduled</li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="section" aria-labelledby="contact-form-title">
    <div class="container contact-layout">
      <div>
        <span class="badge">Send a message</span>
        <h2 id="contact-form-title">Contact our readiness team</h2>
        <p>Messages are delivered to <strong>hello@canonical.plus</strong>. Do not submit credentials, secrets, regulated records, or audit evidence through this public form.</p>
      </div>
      <form class="card contact-form" data-contact-form data-supabase-url={supabaseUrl}>
        <label>Name<input name="name" type="text" autocomplete="name" minlength="2" maxlength="120" required /></label>
        <label>Work email<input name="email" type="email" autocomplete="email" maxlength="320" required /></label>
        <label>Company<input name="company" type="text" autocomplete="organization" minlength="2" maxlength="160" required /></label>
        <label>What can we help with?
          <select name="topic" required>
            <option value="readiness">Readiness / pre-audit</option>
            <option value="remediation">Technical remediation</option>
            <option value="pricing">Pricing / payment plans</option>
            <option value="audit-coordination">Independent audit coordination</option>
            <option value="other">Other</option>
          </select>
        </label>
        <label class="contact-form__wide">Message<textarea name="message" minlength="20" maxlength="4000" rows="7" required></textarea></label>
        <label class="contact-form__trap" aria-hidden="true">Website<input name="website" type="text" tabindex="-1" autocomplete="off" /></label>
        <div class="contact-form__wide action-row">
          <button class="btn btn--primary btn--large" type="submit">Send to hello@canonical.plus</button>
          <a class="btn btn--secondary btn--large" href={pricingHref}>View pricing</a>
        </div>
        <p class="contact-form__wide" data-contact-status role="status"></p>
      </form>
    </div>
  </section>

  <script type="module" src={contactScriptHref}></script>
</BaseLayout>

<style>
  .contact-layout{display:grid;grid-template-columns:minmax(0,.7fr) minmax(0,1.3fr);gap:var(--space-xl);align-items:start}
  .contact-form{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-md)}
  .contact-form label{display:grid;gap:.45rem;color:var(--av-text-secondary);font-weight:700}
  .contact-form input,.contact-form select,.contact-form textarea{width:100%;padding:.8rem;border:1px solid var(--av-border);border-radius:var(--radius-md);background:var(--av-surface);color:var(--av-text-primary)}
  .contact-form__wide{grid-column:1/-1}
  .contact-form__trap{position:absolute!important;left:-10000px!important;width:1px!important;height:1px!important;overflow:hidden!important}
  @media(max-width:900px){.contact-layout,.contact-form{grid-template-columns:1fr}.contact-form__wide{grid-column:auto}}
</style>
