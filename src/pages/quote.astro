---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
import '../styles/marketing-pages.css';
import catalog from '../data/service-tiers.json';
import estimator from '../data/quote-estimator.json';

const EXPECTED_ESTIMATOR_SCHEMA_VERSION = 2;
const pricedItemsAreValid = (items: Array<{ id: string; label: string; amountUsd: number }>) =>
  items.length > 0 &&
  new Set(items.map((item) => item.id)).size === items.length &&
  items.every((item) => item.id && item.label && Number.isFinite(item.amountUsd) && item.amountUsd >= 0);

if (
  estimator.schemaVersion !== EXPECTED_ESTIMATOR_SCHEMA_VERSION ||
  !/^[A-Z]{3}$/.test(estimator.currency) ||
  !Number.isFinite(estimator.estimateFloorUsd) ||
  !Number.isFinite(estimator.estimateCeilingUsd) ||
  estimator.estimateCeilingUsd <= estimator.estimateFloorUsd ||
  !pricedItemsAreValid(estimator.standards) ||
  !pricedItemsAreValid(estimator.deliveryDepths) ||
  !pricedItemsAreValid(estimator.complexities) ||
  !estimator.companyStages?.length ||
  !pricedItemsAreValid(estimator.employeeBands) ||
  !pricedItemsAreValid(estimator.sectors)
) throw new Error('Invalid quote estimator configuration');

const baseNoSlash = import.meta.env.BASE_URL.replace(/\/+$/, '');
const quoteEstimatorScriptHref = `${baseNoSlash}/quote-estimator.js`;
const contactHref = `${baseNoSlash}/contact/`;
const appQuoteUrl = 'https://app.canonical.plus/u/quote';
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL || '';
const money = new Intl.NumberFormat('en-US', { style: 'currency', currency: estimator.currency, maximumFractionDigits: 0 });
---

<BaseLayout
  title="Compliance readiness quote"
  description="Build a scoped Canonical Plus readiness estimate, including organization size and sector, and email the estimate to your team."
>
  <section class="page-hero section--hero bg-grid bg-radial">
    <div class="container page-hero__grid">
      <div class="page-hero__copy">
        <span class="badge">Readiness quote</span>
        <p class="page-hero__eyebrow">Clear scope · practical pricing range · emailed summary</p>
        <h1 class="page-hero__title hero__title">Price the readiness work.<br /><span class="gradient-text">Keep the quote for your team.</span></h1>
        <p class="page-hero__subtitle">
          Estimate readiness and remediation support using delivery speed, frameworks, service depth, environment complexity,
          company stage, and employee count. Business sector is captured as scoping context. Submit the quote to receive a copy by email.
        </p>
      </div>
      <aside class="page-hero__panel">
        <h2>What drives the estimate</h2>
        <ul>
          <li>Delivery timeline and framework scope</li>
          <li>Advisory, managed readiness, or hands-on remediation</li>
          <li>Environment complexity, company stage, and employee scale</li>
          <li>Business sector captured for scoping context</li>
        </ul>
        <p>Planning ranges are non-binding. A reviewed statement of work controls final scope, deliverables, pricing, and deadlines.</p>
      </aside>
    </div>
  </section>

  <section class="section" id="quote-estimator" aria-labelledby="quote-estimator-title">
    <div class="container">
      <header class="section-header">
        <span class="badge">Instant estimator</span>
        <h2 id="quote-estimator-title">Build your project quote</h2>
        <p>Adjust the assumptions below. Pricing is a planning range until scope is reviewed and documented in a signed SOW.</p>
      </header>

      <div
        class="quote-estimator"
        data-quote-estimator
        data-schema-version={estimator.schemaVersion}
        data-currency={estimator.currency}
        data-floor={estimator.estimateFloorUsd}
        data-ceiling={estimator.estimateCeilingUsd}
        data-midpoint-floor={estimator.midpointFloorUsd}
        data-midpoint-ceiling={estimator.midpointCeilingUsd}
        data-round-to={estimator.roundToUsd}
        data-lower-factor={estimator.lowerFactor}
        data-upper-factor={estimator.upperFactor}
        data-supabase-url={supabaseUrl}
      >
        <div class="quote-estimator__controls">
          <section class="quote-control-card" role="group" aria-labelledby="quote-speed-title">
            <h3 id="quote-speed-title">1. Delivery speed</h3>
            <input class="quote-slider" type="range" min="0" max={estimator.speeds.length - 1} step="1" value="1" data-quote-speed-slider aria-label="Delivery speed" />
            <p class="quote-control-note" data-speed-note>{estimator.speeds[1].note}</p>
            <div hidden>{estimator.speeds.map((item, index) => <span data-option="speed" data-index={index} data-id={String(item.weeks)} data-label={item.label} data-amount={item.baseUsd}></span>)}</div>
          </section>

          <section class="quote-control-card" role="group" aria-labelledby="quote-frameworks-title">
            <h3 id="quote-frameworks-title">2. Standards and frameworks</h3>
            <p class="quote-control-note">Choose at least one. Shared controls reduce duplicated effort across frameworks.</p>
            <div class="quote-checkbox-grid" data-standards-group>
              {estimator.standards.map((item) => (
                <label class="quote-check"><input type="checkbox" name="quote_standard" value={item.id} data-label={item.label} data-amount={item.amountUsd} checked={estimator.defaults.standardIds.includes(item.id)} /><span>{item.label}</span></label>
              ))}
            </div>
            <p class="quote-validation" data-standard-error role="alert" hidden>Please select at least one framework.</p>
          </section>

          <section class="quote-control-card" role="group" aria-labelledby="quote-depth-title">
            <h3 id="quote-depth-title">3. Service depth</h3>
            <div class="quote-radio-list">
              {estimator.deliveryDepths.map((item) => (
                <label class="quote-radio"><input type="radio" name="quote_delivery_depth" value={item.id} data-label={item.label} data-amount={item.amountUsd} checked={item.id === estimator.defaults.deliveryDepthId} /><span><strong>{item.label}</strong><small>{item.note}</small></span></label>
              ))}
            </div>
          </section>

          <section class="quote-control-card" role="group" aria-labelledby="quote-complexity-title">
            <h3 id="quote-complexity-title">4. Environment complexity</h3>
            <div class="quote-radio-list">
              {estimator.complexities.map((item) => (
                <label class="quote-radio"><input type="radio" name="quote_complexity" value={item.id} data-label={item.label} data-amount={item.amountUsd} checked={item.id === estimator.defaults.complexityId} /><span><strong>{item.label}</strong><small>{item.note}</small></span></label>
              ))}
            </div>
          </section>

          <section class="quote-control-card" role="group" aria-labelledby="quote-org-title">
            <h3 id="quote-org-title">5. Organization profile</h3>
            <div class="quote-profile-grid">
              <label>Company stage
                <select name="quote_company_stage">
                  {estimator.companyStages.map((item) => <option value={item.id} data-label={item.label} data-multiplier={item.multiplier} selected={item.id === estimator.defaults.companyStageId}>{item.label}</option>)}
                </select>
              </label>
              <label>Employees
                <select name="quote_employee_band">
                  {estimator.employeeBands.map((item) => <option value={item.id} data-label={item.label} data-amount={item.amountUsd} selected={estimator.defaults.employeeCount >= item.min && estimator.defaults.employeeCount <= item.max}>{item.label}</option>)}
                </select>
              </label>
              <label>Business sector
                <select name="quote_sector">
                  {estimator.sectors.map((item) => <option value={item.id} data-label={item.label} data-amount={item.amountUsd} selected={item.id === estimator.defaults.sectorId}>{item.label}</option>)}
                </select>
              </label>
            </div>
          </section>

          <section class="quote-control-card" aria-labelledby="quote-recipient-title">
            <h3 id="quote-recipient-title">6. Email this quote</h3>
            <div class="quote-profile-grid">
              <label>Work email
                <input type="email" name="quote_email" autocomplete="email" maxlength="320" required placeholder="you@company.com" />
              </label>
              <label>Company
                <input type="text" name="quote_company" autocomplete="organization" minlength="2" maxlength="160" required placeholder="Company name" />
              </label>
            </div>
            <label class="quote-form__trap" aria-hidden="true">Website<input type="text" name="quote_website" tabindex="-1" autocomplete="off" /></label>
            <p class="quote-control-note">We email the estimate and scope summary to you and copy <strong>hello@canonical.plus</strong> so our team can follow up.</p>
          </section>
        </div>

        <aside class="quote-estimator__result" aria-live="polite">
          <p class="quote-estimator__eyebrow">Estimated project range</p>
          <p class="quote-estimator__price"><strong data-quote-range>{money.format(10000)}–{money.format(12500)}</strong></p>
          <p class="quote-estimator__summary" data-quote-summary>5 weeks · SOC 2 + ISO 27001 · Managed readiness · Growing environment · Business · 11–50 employees · Technology / SaaS</p>
          <div class="quote-estimator__meter" aria-hidden="true"><span data-quote-meter></span></div>
          <p class="quote-estimator__boundary">Typical estimator range: {money.format(estimator.estimateFloorUsd)}–{money.format(estimator.estimateCeilingUsd)}. Final pricing depends on validated scope.</p>
          <button class="btn btn--primary btn--large" type="button" data-complete-public-quote>Email my quote</button>
          <p class="quote-estimator__status" data-quote-status role="status"></p>
          <a class="btn btn--secondary" href={appQuoteUrl}>Sign in for account quote</a>
          <p class="quote-estimator__privacy">Quote submissions are stored for follow-up and delivery. Do not include secrets, credentials, regulated data, or audit evidence in this public form.</p>
        </aside>
      </div>

      <section class="quote-complete" data-quote-complete hidden tabindex="-1">
        <span class="badge">Quote sent</span>
        <h2>Your planning estimate is on its way</h2>
        <p data-completed-range></p>
        <p data-completed-summary></p>
        <p>We also copied hello@canonical.plus. A signed statement of work controls final commercial terms.</p>
      </section>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="badge">Flexible commercial terms</span>
        <h2>Payment plans and scoped engagement discounts</h2>
        <p>Qualifying engagements can be structured in milestone-based payment plans. Larger full-program readiness engagements may qualify for scoped discounts. Independent auditor or certification-body fees are itemized separately unless a written order expressly states otherwise.</p>
      </div>
      <div class="quote-tier-grid">
        {catalog.tiers.map((tier) => (
          <article class="card quote-tier-card">
            <div><p class="quote-tier-card__eyebrow">{tier.name}</p><p class="quote-tier-card__price"><strong>{money.format(tier.monthlyUsd)}</strong> <span>/ month</span></p><p>{tier.summary}</p></div>
            <ul>{tier.includes.map((item) => <li>{item}</li>)}</ul>
            <a class="btn btn--secondary" href={contactHref}>Discuss this package</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <script type="module" src={quoteEstimatorScriptHref}></script>
</BaseLayout>

<style>
  .quote-estimator { display:grid; grid-template-columns:minmax(0,1.5fr) minmax(300px,.75fr); gap:var(--space-xl); align-items:start; }
  .quote-estimator__controls { display:grid; gap:var(--space-lg); }
  .quote-control-card { margin:0; padding:clamp(1.2rem,2vw,1.65rem); border:1px solid var(--av-border); border-radius:var(--radius-lg); background:var(--av-surface); }
  .quote-control-card h3 { margin:0 0 .9rem; font-size:1.08rem; }
  .quote-control-note { color:var(--av-text-secondary); line-height:1.55; }
  .quote-slider { width:100%; accent-color:var(--av-accent); }
  .quote-checkbox-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:.65rem; }
  .quote-check,.quote-radio { display:flex; gap:.7rem; align-items:flex-start; padding:.8rem; border:1px solid var(--av-border); border-radius:var(--radius-md); cursor:pointer; }
  .quote-radio-list { display:grid; gap:.65rem; }
  .quote-radio span { display:grid; gap:.2rem; }
  .quote-radio small { color:var(--av-text-secondary); }
  .quote-profile-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:.85rem; }
  .quote-profile-grid label { display:grid; gap:.45rem; color:var(--av-text-secondary); font-weight:700; }
  .quote-profile-grid input,.quote-profile-grid select { width:100%; min-height:46px; padding:.7rem .8rem; border:1px solid var(--av-border); border-radius:var(--radius-md); background:var(--av-surface); color:var(--av-text-primary); }
  .quote-validation { color:#ef7b72; font-weight:700; }
  .quote-form__trap{position:absolute!important;left:-10000px!important;width:1px!important;height:1px!important;overflow:hidden!important}
  .quote-estimator__result { position:sticky; top:6rem; display:grid; gap:1rem; padding:clamp(1.35rem,3vw,2rem); border:1px solid var(--av-border); border-radius:var(--radius-lg); background:var(--av-surface); box-shadow:var(--shadow-lg); }
  .quote-estimator__eyebrow { margin:0; color:var(--av-accent); font-weight:800; text-transform:uppercase; letter-spacing:.05em; }
  .quote-estimator__price { margin:0; }
  .quote-estimator__price strong { font-size:clamp(2rem,5vw,3.4rem); letter-spacing:-.04em; }
  .quote-estimator__summary,.quote-estimator__boundary,.quote-estimator__privacy,.quote-estimator__status { margin:0; color:var(--av-text-secondary); line-height:1.55; }
  .quote-estimator__meter { height:.65rem; overflow:hidden; border-radius:999px; background:var(--av-border); }
  .quote-estimator__meter span { display:block; height:100%; width:50%; border-radius:inherit; background:var(--av-accent); transition:width .2s ease; }
  .quote-complete { margin-top:var(--space-xl); padding:clamp(1.5rem,4vw,2.5rem); border:1px solid var(--av-border); border-radius:var(--radius-lg); background:var(--av-surface); }
  .quote-tier-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:var(--space-lg); }
  .quote-tier-card { display:flex; flex-direction:column; justify-content:space-between; gap:var(--space-lg); }
  .quote-tier-card__eyebrow { color:var(--av-accent); font-weight:750; text-transform:uppercase; }
  @media(max-width:900px){.quote-estimator,.quote-tier-grid,.quote-profile-grid{grid-template-columns:1fr}.quote-estimator__result{position:static}}
  @media(max-width:620px){.quote-checkbox-grid{grid-template-columns:1fr}}
</style>
