---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
import '../styles/marketing-pages.css';
import catalog from '../data/service-tiers.json';
import estimator from '../data/quote-estimator.json';

const EXPECTED_ESTIMATOR_SCHEMA_VERSION = 2;
const isFiniteNonnegative = (value: number) => Number.isFinite(value) && value >= 0;
const idsAreUnique = (items: Array<{ id: string }>) => new Set(items.map((item) => item.id)).size === items.length;
const pricedItemsAreValid = (items: Array<{ id: string; label: string; amountUsd: number }>) =>
  idsAreUnique(items) && items.every((item) => item.id.length > 0 && item.label.length > 0 && isFiniteNonnegative(item.amountUsd));
const employeeBandsAreValid =
  idsAreUnique(estimator.employeeBands) &&
  estimator.employeeBands.length > 0 &&
  estimator.employeeBands.every((band, index) => {
    if (!band.id || !band.label || !Number.isInteger(band.minEmployees) || band.minEmployees < 1 || !isFiniteNonnegative(band.amountUsd)) return false;
    if (band.maxEmployees !== null && (!Number.isInteger(band.maxEmployees) || band.maxEmployees < band.minEmployees)) return false;
    if (index === 0 && band.minEmployees !== 1) return false;
    if (index > 0) {
      const previous = estimator.employeeBands[index - 1];
      if (previous.maxEmployees === null || band.minEmployees !== previous.maxEmployees + 1) return false;
    }
    return index < estimator.employeeBands.length - 1 ? band.maxEmployees !== null : band.maxEmployees === null;
  });

if (
  estimator.schemaVersion !== EXPECTED_ESTIMATOR_SCHEMA_VERSION ||
  !/^\d{4}-\d{2}-\d{2}-v\d+$/.test(estimator.pricingRevision) ||
  !/^[A-Z]{3}$/.test(estimator.currency) ||
  !isFiniteNonnegative(estimator.estimateFloorUsd) ||
  !Number.isFinite(estimator.estimateCeilingUsd) ||
  estimator.estimateCeilingUsd <= estimator.estimateFloorUsd ||
  !Number.isFinite(estimator.midpointFloorUsd) ||
  estimator.midpointFloorUsd < estimator.estimateFloorUsd ||
  !Number.isFinite(estimator.midpointCeilingUsd) ||
  estimator.midpointCeilingUsd < estimator.midpointFloorUsd ||
  estimator.midpointCeilingUsd > estimator.estimateCeilingUsd ||
  !Number.isFinite(estimator.roundToUsd) ||
  estimator.roundToUsd <= 0 ||
  !Number.isFinite(estimator.lowerFactor) ||
  estimator.lowerFactor <= 0 ||
  !Number.isFinite(estimator.upperFactor) ||
  estimator.upperFactor < estimator.lowerFactor ||
  estimator.speeds.length === 0 ||
  new Set(estimator.speeds.map((speed) => speed.weeks)).size !== estimator.speeds.length ||
  estimator.speeds.some((speed) => !Number.isInteger(speed.weeks) || speed.weeks <= 0 || !speed.label || !isFiniteNonnegative(speed.baseUsd)) ||
  !pricedItemsAreValid(estimator.standards) ||
  !pricedItemsAreValid(estimator.deliveryDepths) ||
  !pricedItemsAreValid(estimator.complexities) ||
  !pricedItemsAreValid(estimator.organizationTypes) ||
  !pricedItemsAreValid(estimator.sectors) ||
  !employeeBandsAreValid
) {
  throw new Error('Invalid quote estimator configuration');
}

const defaultSpeedIndex = estimator.speeds.findIndex((speed) => speed.weeks === estimator.defaults.speedWeeks);
const defaultSpeed = estimator.speeds[defaultSpeedIndex];
const defaultStandardIds = new Set(estimator.defaults.standardIds);
const defaultStandards = estimator.standards.filter((standard) => defaultStandardIds.has(standard.id));
const defaultDepth = estimator.deliveryDepths.find((depth) => depth.id === estimator.defaults.deliveryDepthId);
const defaultComplexity = estimator.complexities.find((complexity) => complexity.id === estimator.defaults.complexityId);
const defaultOrganizationType = estimator.organizationTypes.find((item) => item.id === estimator.defaults.organizationTypeId);
const defaultSector = estimator.sectors.find((item) => item.id === estimator.defaults.sectorId);
const defaultEmployeeBand = estimator.employeeBands.find((band) =>
  estimator.defaults.employeeCount >= band.minEmployees &&
  (band.maxEmployees === null || estimator.defaults.employeeCount <= band.maxEmployees)
);

if (
  defaultSpeedIndex < 0 ||
  !defaultSpeed ||
  defaultStandardIds.size === 0 ||
  defaultStandards.length !== defaultStandardIds.size ||
  !defaultDepth ||
  !defaultComplexity ||
  !defaultOrganizationType ||
  !defaultSector ||
  !defaultEmployeeBand ||
  !Number.isInteger(estimator.defaults.employeeCount) ||
  estimator.defaults.employeeCount < 1
) {
  throw new Error('Invalid quote estimator defaults');
}

const money = new Intl.NumberFormat('en-US', {
  style: 'currency',
  currency: catalog.source.currency,
  maximumFractionDigits: 0,
});
const clamp = (value: number, min: number, max: number) => Math.min(max, Math.max(min, value));
const roundMoney = (value: number) => Math.round(value / estimator.roundToUsd) * estimator.roundToUsd;
const defaultStandardAmount = defaultStandards.reduce((total, standard) => total + standard.amountUsd, 0);
const defaultMidpoint = clamp(
  defaultSpeed.baseUsd +
    defaultStandardAmount +
    defaultDepth.amountUsd +
    defaultComplexity.amountUsd +
    defaultOrganizationType.amountUsd +
    defaultEmployeeBand.amountUsd +
    defaultSector.amountUsd,
  estimator.midpointFloorUsd,
  estimator.midpointCeilingUsd,
);
const defaultLower = clamp(
  roundMoney(defaultMidpoint * estimator.lowerFactor),
  estimator.estimateFloorUsd,
  estimator.estimateCeilingUsd,
);
const defaultUpper = clamp(
  roundMoney(defaultMidpoint * estimator.upperFactor),
  defaultLower,
  estimator.estimateCeilingUsd,
);
const initialRange = `${money.format(defaultLower)}–${money.format(defaultUpper)}`;
const initialSummary = `${defaultSpeed.label} · ${defaultStandards.map((standard) => standard.label).join(' + ')} · ${defaultDepth.label} · ${defaultComplexity.label} · ${defaultOrganizationType.label} · ${defaultEmployeeBand.label} · ${defaultSector.label}`;

const baseNoSlash = import.meta.env.BASE_URL.replace(/\/+$/, '');
const quoteEstimatorScriptHref = `${baseNoSlash}/quote-estimator.js`;
const contactHref = `${baseNoSlash}/contact/`;
const appQuoteUrl = 'https://app.canonical.plus/u/quote';
---

<BaseLayout
  title="Compliance readiness quote"
  description="Build a Canonical Plus readiness and pre-audit planning estimate based on timeline, frameworks, service depth, environment, organization profile, employee count, and sector."
>
  <section class="page-hero section--hero bg-grid bg-radial">
    <div class="container page-hero__grid">
      <div class="page-hero__copy">
        <span class="badge">Readiness + pre-audit quote</span>
        <p class="page-hero__eyebrow">No account required · instant planning range</p>
        <h1 class="page-hero__title hero__title">Scope the readiness work.<br /><span class="gradient-text">Get a useful range in minutes.</span></h1>
        <p class="page-hero__subtitle">
          Model delivery speed, target frameworks, service depth, environment complexity, organization stage, employee count, and business sector.
          The calculator stays in your browser until you explicitly ask us to email the quote.
        </p>
        <div class="page-hero__actions">
          <a class="btn btn--primary btn--large" href="#quote-estimator">Build my quote</a>
          <a class="btn btn--secondary btn--large" href="mailto:hello@canonical.plus">hello@canonical.plus</a>
        </div>
      </div>
      <aside class="page-hero__panel">
        <h2>Canonical supports readiness and pre-audits</h2>
        <ul>
          <li>Readiness assessment, control mapping, evidence planning, and technical remediation</li>
          <li>SOC 2, ISO 27001, NIST, GDPR, HIPAA, PCI DSS, FedRAMP, CIS Controls, and related scopes</li>
          <li>Organization size and sector-sensitive scoping for stakeholder and evidence complexity</li>
          <li>Independent-review handoff and auditor collaboration when you move into formal assurance</li>
        </ul>
        <p>Ask about milestone payment plans and package discounts for larger readiness engagements. Independent auditor fees remain separately scoped unless a signed Order or SOW says otherwise.</p>
      </aside>
    </div>
  </section>

  <section class="section" id="quote-estimator" aria-labelledby="quote-estimator-title">
    <div class="container">
      <div class="section-header">
        <span class="badge">Instant estimator</span>
        <h2 id="quote-estimator-title">Build your project quote</h2>
        <p>Adjust the factors that materially change readiness effort. Calculation is local; nothing is transmitted until you choose “Email my quote.”</p>
      </div>

      <div
        class="quote-estimator"
        data-quote-estimator
        data-schema-version={estimator.schemaVersion}
        data-pricing-revision={estimator.pricingRevision}
        data-currency={estimator.currency}
        data-floor={estimator.estimateFloorUsd}
        data-ceiling={estimator.estimateCeilingUsd}
        data-midpoint-floor={estimator.midpointFloorUsd}
        data-midpoint-ceiling={estimator.midpointCeilingUsd}
        data-round-to={estimator.roundToUsd}
        data-lower-factor={estimator.lowerFactor}
        data-upper-factor={estimator.upperFactor}
      >
        <div class="quote-estimator__controls">
          <fieldset class="quote-control-card">
            <legend>1. Delivery speed</legend>
            <div class="quote-slider__heading">
              <span>More planning room</span>
              <strong data-speed-label>{defaultSpeed.label}</strong>
              <span>Faster delivery</span>
            </div>
            <input
              class="quote-slider"
              id="quote-speed"
              type="range"
              min="0"
              max={estimator.speeds.length - 1}
              step="1"
              value={defaultSpeedIndex}
              aria-label="Delivery speed"
              aria-valuetext={defaultSpeed.label}
              data-quote-speed-slider
            />
            <div class="quote-slider__ticks" aria-hidden="true">
              {estimator.speeds.map((speed) => <span>{speed.label}</span>)}
            </div>
            <p class="quote-control-note" data-speed-note>{defaultSpeed.note}</p>
            <div hidden aria-hidden="true">
              {estimator.speeds.map((speed, index) => (
                <span
                  data-quote-speed-option
                  data-index={index}
                  data-weeks={speed.weeks}
                  data-label={speed.label}
                  data-base={speed.baseUsd}
                  data-note={speed.note}
                ></span>
              ))}
            </div>
          </fieldset>

          <fieldset class="quote-control-card" aria-describedby="quote-standard-note quote-standard-error">
            <legend>2. Standards to meet</legend>
            <p class="quote-control-note" id="quote-standard-note">Choose at least one. Overlapping control work is intentionally priced below a simple per-framework sum.</p>
            <div class="quote-checkbox-grid" data-standards-group>
              {estimator.standards.map((standard) => (
                <label class="quote-check">
                  <input
                    type="checkbox"
                    name="quote_standard"
                    value={standard.id}
                    data-label={standard.label}
                    data-amount={standard.amountUsd}
                    checked={defaultStandardIds.has(standard.id)}
                  />
                  <span>{standard.label}</span>
                </label>
              ))}
            </div>
            <p class="quote-validation" id="quote-standard-error" data-standard-error role="alert" hidden>Please select at least one standard.</p>
          </fieldset>

          <fieldset class="quote-control-card">
            <legend>3. Service depth</legend>
            <div class="quote-radio-list">
              {estimator.deliveryDepths.map((depth) => (
                <label class="quote-radio">
                  <input
                    type="radio"
                    name="quote_delivery_depth"
                    value={depth.id}
                    data-label={depth.label}
                    data-amount={depth.amountUsd}
                    checked={depth.id === defaultDepth.id}
                  />
                  <span><strong>{depth.label}</strong><small>{depth.note}</small></span>
                </label>
              ))}
            </div>
          </fieldset>

          <fieldset class="quote-control-card">
            <legend>4. Environment complexity</legend>
            <div class="quote-radio-list">
              {estimator.complexities.map((complexity) => (
                <label class="quote-radio">
                  <input
                    type="radio"
                    name="quote_complexity"
                    value={complexity.id}
                    data-label={complexity.label}
                    data-amount={complexity.amountUsd}
                    checked={complexity.id === defaultComplexity.id}
                  />
                  <span><strong>{complexity.label}</strong><small>{complexity.note}</small></span>
                </label>
              ))}
            </div>
          </fieldset>

          <fieldset class="quote-control-card">
            <legend>5. Organization type</legend>
            <label class="quote-select-label" for="quote-organization-type">How would you describe the organization?</label>
            <select id="quote-organization-type" class="quote-select" data-quote-organization-type>
              {estimator.organizationTypes.map((item) => (
                <option
                  value={item.id}
                  data-label={item.label}
                  data-amount={item.amountUsd}
                  selected={item.id === defaultOrganizationType.id}
                >{item.label}</option>
              ))}
            </select>
            <p class="quote-control-note" data-organization-type-note>{defaultOrganizationType.note}</p>
          </fieldset>

          <fieldset class="quote-control-card">
            <legend>6. Number of employees</legend>
            <label class="quote-select-label" for="quote-employees">Current employee count</label>
            <input
              id="quote-employees"
              class="quote-number-input"
              type="number"
              inputmode="numeric"
              min="1"
              max="100000"
              step="1"
              value={estimator.defaults.employeeCount}
              data-quote-employees
            />
            <p class="quote-control-note">We use broad employee bands to estimate stakeholder, access-review, evidence-owner, and policy coordination effort.</p>
            <p class="quote-band" data-employee-band>{defaultEmployeeBand.label}</p>
            <div hidden aria-hidden="true">
              {estimator.employeeBands.map((band, index) => (
                <span
                  data-quote-employee-band
                  data-index={index}
                  data-id={band.id}
                  data-label={band.label}
                  data-min={band.minEmployees}
                  data-max={band.maxEmployees ?? ''}
                  data-amount={band.amountUsd}
                ></span>
              ))}
            </div>
          </fieldset>

          <fieldset class="quote-control-card">
            <legend>7. Business sector</legend>
            <label class="quote-select-label" for="quote-sector">Primary sector</label>
            <select id="quote-sector" class="quote-select" data-quote-sector>
              {estimator.sectors.map((item) => (
                <option
                  value={item.id}
                  data-label={item.label}
                  data-amount={item.amountUsd}
                  selected={item.id === defaultSector.id}
                >{item.label}</option>
              ))}
            </select>
            <p class="quote-control-note">Sector changes the likely data sensitivity, vendor, evidence, and regulatory coordination burden. Final scope is validated before contracting.</p>
          </fieldset>
        </div>

        <aside class="quote-estimator__result" aria-live="polite" aria-atomic="true">
          <p class="quote-estimator__eyebrow">Estimated project range</p>
          <p class="quote-estimator__price"><strong data-quote-range>{initialRange}</strong></p>
          <p class="quote-estimator__summary" data-quote-summary>{initialSummary}</p>
          <div class="quote-estimator__meter" aria-hidden="true"><span data-quote-meter></span></div>
          <p class="quote-estimator__boundary">Planning range: {money.format(estimator.estimateFloorUsd)}–{money.format(estimator.estimateCeilingUsd)}. A reviewed Order or SOW controls final scope, price, deliverables, and dates.</p>
          <p class="quote-estimator__commercial">Milestone payment plans and package discounts may be available for larger readiness programs. Independent audit or certification-body fees are separate unless expressly itemized in a signed Order or SOW.</p>
          <button class="btn btn--primary btn--large" type="button" data-complete-public-quote>Review &amp; email quote</button>
          <a class="btn btn--secondary" href={appQuoteUrl} data-quote-login>Sign in for account workflow</a>
          <a class="quote-estimator__email" href="mailto:hello@canonical.plus">Questions? hello@canonical.plus</a>
          <p class="quote-estimator__privacy">The estimate is calculated locally. Data is sent only after you submit the email form below.</p>
        </aside>
      </div>

      <section class="quote-complete" data-quote-complete hidden tabindex="-1" aria-labelledby="quote-complete-title">
        <span class="badge">Planning estimate ready</span>
        <h2 id="quote-complete-title">Email this quote to your team</h2>
        <p class="quote-complete__range" data-completed-range></p>
        <p data-completed-summary></p>
        <p>This is a non-binding planning estimate. Canonical Plus validates scope, commercial terms, deliverables, deadlines, and any discounts before a signed Order or SOW.</p>

        <form class="quote-email-form" data-quote-email-form novalidate>
          <div class="quote-form-grid">
            <label>
              <span>Work email</span>
              <input type="email" name="email" autocomplete="email" maxlength="320" required />
            </label>
            <label>
              <span>Name <small>(optional)</small></span>
              <input type="text" name="displayName" autocomplete="name" maxlength="120" />
            </label>
            <label>
              <span>Organization <small>(optional)</small></span>
              <input type="text" name="organizationName" autocomplete="organization" maxlength="200" />
            </label>
          </div>
          <label class="quote-honeypot" aria-hidden="true">
            <span>Website</span>
            <input type="text" name="website" tabindex="-1" autocomplete="off" />
          </label>
          <p class="quote-form-copy">We’ll email the quote details to you and copy <strong>hello@canonical.plus</strong> so our team can follow up on the scope you requested. This form does not opt you into a marketing list.</p>
          <div class="page-hero__actions">
            <button class="btn btn--primary" type="submit" data-quote-email-submit>Email my quote</button>
            <a class="btn btn--secondary" href={contactHref}>Contact us another way</a>
          </div>
          <p class="quote-form-status" data-quote-email-status role="status" aria-live="polite"></p>
        </form>
        <noscript>
          <p>JavaScript is required to email the generated estimate. You can always contact <a href="mailto:hello@canonical.plus">hello@canonical.plus</a>.</p>
        </noscript>
      </section>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="badge">Ongoing service tiers</span>
        <h2>Three published starting points</h2>
        <p>These recurring readiness tiers are separate from the one-time project estimate above. Ask about annual-payment discounts and milestone schedules where appropriate.</p>
      </div>
      <div class="quote-tier-grid" aria-label="Canonical readiness service levels">
        {catalog.tiers.map((tier) => (
          <article class="card quote-tier-card">
            <div>
              <p class="quote-tier-card__eyebrow">{tier.name}</p>
              <p class="quote-tier-card__price"><strong>{money.format(tier.monthlyUsd)}</strong> <span>/ month</span></p>
              <p>{tier.summary}</p>
            </div>
            <ul>{tier.includes.map((item) => <li>{item}</li>)}</ul>
            <a class="btn btn--secondary" href={contactHref}>Discuss this tier</a>
          </article>
        ))}
      </div>
      <p class="quote-disclaimer">Canonical Plus prepares teams for independent review and can coordinate the handoff. Formal audit opinions, certifications, and authorizations are issued by the qualified independent provider responsible for that engagement.</p>
    </div>
  </section>

  <script type="module" src={quoteEstimatorScriptHref}></script>
</BaseLayout>

<style>
  .quote-estimator { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(280px, .75fr); gap: var(--space-xl); align-items: start; }
  .quote-estimator__controls { display: grid; gap: var(--space-lg); }
  .quote-control-card { margin: 0; padding: clamp(1.15rem, 2vw, 1.6rem); border: 1px solid var(--av-border); border-radius: var(--radius-lg); background: var(--av-surface); min-inline-size: 0; }
  .quote-control-card legend { float: left; width: 100%; padding: 0; margin: 0 0 1rem; color: var(--av-text-primary); font-size: 1.05rem; font-weight: 800; line-height: 1.35; }
  .quote-control-card legend + * { clear: both; }
  .quote-control-note { margin: .45rem 0 0; color: var(--av-text-secondary); line-height: 1.55; }
  .quote-slider { width: 100%; accent-color: var(--av-accent); }
  .quote-slider__heading, .quote-slider__ticks { display: grid; grid-template-columns: 1fr auto 1fr; gap: .75rem; align-items: center; }
  .quote-slider__heading { margin-bottom: .8rem; color: var(--av-text-secondary); font-size: .88rem; }
  .quote-slider__heading strong { color: var(--av-text-primary); font-size: 1.05rem; }
  .quote-slider__heading span:last-child { text-align: right; }
  .quote-slider__ticks { grid-template-columns: repeat(3, 1fr); margin-top: .35rem; color: var(--av-text-secondary); font-size: .8rem; }
  .quote-slider__ticks span:nth-child(2) { text-align: center; }
  .quote-slider__ticks span:last-child { text-align: right; }
  .quote-checkbox-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .65rem; }
  .quote-check, .quote-radio { display: flex; gap: .7rem; align-items: flex-start; padding: .8rem; border: 1px solid var(--av-border); border-radius: var(--radius-md); cursor: pointer; }
  .quote-check input, .quote-radio input { margin-top: .18rem; accent-color: var(--av-accent); }
  .quote-radio-list { display: grid; gap: .65rem; }
  .quote-radio span { display: grid; gap: .2rem; }
  .quote-radio small { color: var(--av-text-secondary); line-height: 1.45; }
  .quote-select-label, .quote-email-form label { display: grid; gap: .5rem; color: var(--av-text-primary); font-weight: 700; }
  .quote-select, .quote-number-input, .quote-email-form input { width: 100%; min-height: 3rem; padding: .7rem .8rem; border: 1px solid var(--av-border); border-radius: var(--radius-md); background: var(--av-surface-raised, var(--av-surface)); color: var(--av-text-primary); font: inherit; }
  .quote-select:focus-visible, .quote-number-input:focus-visible, .quote-email-form input:focus-visible { outline: 2px solid var(--av-accent); outline-offset: 2px; }
  .quote-band { display: inline-flex; width: fit-content; margin: .8rem 0 0; padding: .35rem .65rem; border-radius: 999px; background: color-mix(in srgb, var(--av-accent) 15%, transparent); color: var(--av-accent); font-weight: 800; }
  .quote-validation { color: #ef7b72; font-weight: 700; }
  .quote-estimator__result { position: sticky; top: 6rem; display: grid; gap: 1rem; padding: clamp(1.35rem, 3vw, 2rem); border: 1px solid var(--av-border); border-radius: var(--radius-lg); background: var(--av-surface); box-shadow: var(--shadow-lg); }
  .quote-estimator__eyebrow { margin: 0; color: var(--av-accent); font-weight: 800; text-transform: uppercase; letter-spacing: .05em; }
  .quote-estimator__price { margin: 0; }
  .quote-estimator__price strong { font-size: clamp(2rem, 5vw, 3.65rem); letter-spacing: -.04em; }
  .quote-estimator__summary, .quote-estimator__boundary, .quote-estimator__commercial, .quote-estimator__privacy { margin: 0; color: var(--av-text-secondary); line-height: 1.55; }
  .quote-estimator__commercial { padding: .85rem; border: 1px solid var(--av-border); border-radius: var(--radius-md); background: color-mix(in srgb, var(--av-accent) 6%, transparent); }
  .quote-estimator__email { color: var(--av-accent); font-weight: 800; }
  .quote-estimator__meter { height: .65rem; overflow: hidden; border-radius: 999px; background: var(--av-border); }
  .quote-estimator__meter span { display: block; height: 100%; width: 50%; border-radius: inherit; background: var(--av-accent); transition: width .2s ease; }
  .quote-complete { margin-top: var(--space-xl); padding: clamp(1.5rem, 4vw, 2.5rem); border: 1px solid var(--av-border); border-radius: var(--radius-lg); background: var(--av-surface); }
  .quote-complete__range { font-size: clamp(2rem, 5vw, 3.2rem); font-weight: 850; letter-spacing: -.04em; }
  .quote-email-form { display: grid; gap: 1rem; margin-top: var(--space-lg); padding-top: var(--space-lg); border-top: 1px solid var(--av-border); }
  .quote-form-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .quote-email-form label span { font-size: .92rem; }
  .quote-email-form label small { color: var(--av-text-muted); font-weight: 500; }
  .quote-form-copy, .quote-form-status { margin: 0; color: var(--av-text-secondary); line-height: 1.55; }
