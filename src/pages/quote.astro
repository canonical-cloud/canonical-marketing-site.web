---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
import '../styles/marketing-pages.css';
import catalog from '../data/service-tiers.json';
import estimator from '../data/quote-estimator.json';

const EXPECTED_ESTIMATOR_SCHEMA_VERSION = 2;
const isFiniteNonnegative = (value: number) => Number.isFinite(value) && value >= 0;
const idsAreUnique = (items: Array<{ id: string }>) => new Set(items.map((item) => item.id)).size === items.length;
const pricedItemsAreValid = (items: Array<{ id: string; label: string; amountUsd: number }>) =>
  idsAreUnique(items) && items.every((item) => item.id.length > 0 && item.label.length > 0 && isFiniteNonnegative(item.amountUsd));

if (
  estimator.schemaVersion !== EXPECTED_ESTIMATOR_SCHEMA_VERSION ||
  !/^[A-Z]{3}$/.test(estimator.currency) ||
  !isFiniteNonnegative(estimator.estimateFloorUsd) ||
  !Number.isFinite(estimator.estimateCeilingUsd) ||
  estimator.estimateCeilingUsd <= estimator.estimateFloorUsd ||
  !Number.isFinite(estimator.midpointFloorUsd) ||
  estimator.midpointFloorUsd < estimator.estimateFloorUsd ||
  !Number.isFinite(estimator.midpointCeilingUsd) ||
  estimator.midpointCeilingUsd < estimator.midpointFloorUsd ||
  estimator.midpointCeilingUsd > estimator.estimateCeilingUsd ||
  !Number.isFinite(estimator.roundToUsd) ||
  estimator.roundToUsd <= 0 ||
  !Number.isFinite(estimator.lowerFactor) ||
  estimator.lowerFactor <= 0 ||
  !Number.isFinite(estimator.upperFactor) ||
  estimator.upperFactor < estimator.lowerFactor ||
  estimator.speeds.length === 0 ||
  estimator.speeds.some((speed) => !Number.isInteger(speed.weeks) || speed.weeks <= 0 || !speed.label || !isFiniteNonnegative(speed.baseUsd)) ||
  !pricedItemsAreValid(estimator.standards) ||
  !pricedItemsAreValid(estimator.deliveryDepths) ||
  !pricedItemsAreValid(estimator.complexities) ||
  !pricedItemsAreValid(estimator.employeeBands) ||
  !pricedItemsAreValid(estimator.sectors) ||
  !idsAreUnique(estimator.companyStages) ||
  estimator.companyStages.some((stage) => !stage.label || !Number.isFinite(stage.multiplier) || stage.multiplier <= 0)
) {
  throw new Error('Invalid quote estimator configuration');
}

const defaultSpeedIndex = estimator.speeds.findIndex((speed) => speed.weeks === estimator.defaults.speedWeeks);
const defaultSpeed = estimator.speeds[defaultSpeedIndex];
const defaultStandardIds = new Set(estimator.defaults.standardIds);
const defaultStandards = estimator.standards.filter((standard) => defaultStandardIds.has(standard.id));
const defaultDepth = estimator.deliveryDepths.find((depth) => depth.id === estimator.defaults.deliveryDepthId);
const defaultComplexity = estimator.complexities.find((complexity) => complexity.id === estimator.defaults.complexityId);
const defaultStage = estimator.companyStages.find((stage) => stage.id === estimator.defaults.companyStageId);
const defaultEmployeeBand = estimator.employeeBands.find(
  (band) => estimator.defaults.employeeCount >= band.min && estimator.defaults.employeeCount <= band.max,
);
const defaultSector = estimator.sectors.find((sector) => sector.id === estimator.defaults.sectorId);

if (!defaultSpeed || !defaultStandards.length || !defaultDepth || !defaultComplexity || !defaultStage || !defaultEmployeeBand || !defaultSector) {
  throw new Error('Invalid quote estimator defaults');
}

const money = new Intl.NumberFormat('en-US', {
  style: 'currency',
  currency: catalog.source.currency,
  maximumFractionDigits: 0,
});
const clamp = (value: number, min: number, max: number) => Math.min(max, Math.max(min, value));
const roundMoney = (value: number) => Math.round(value / estimator.roundToUsd) * estimator.roundToUsd;
const defaultStandardAmount = defaultStandards.reduce((total, standard) => total + standard.amountUsd, 0);
const defaultBase = defaultSpeed.baseUsd + defaultStandardAmount + defaultDepth.amountUsd + defaultComplexity.amountUsd + defaultEmployeeBand.amountUsd + defaultSector.amountUsd;
const defaultMidpoint = clamp(defaultBase * defaultStage.multiplier, estimator.midpointFloorUsd, estimator.midpointCeilingUsd);
const defaultLower = clamp(roundMoney(defaultMidpoint * estimator.lowerFactor), estimator.estimateFloorUsd, estimator.estimateCeilingUsd);
const defaultUpper = clamp(roundMoney(defaultMidpoint * estimator.upperFactor), defaultLower, estimator.estimateCeilingUsd);
const initialRange = `${money.format(defaultLower)}–${money.format(defaultUpper)}`;
const initialSummary = `${defaultStage.label} · ${defaultEmployeeBand.label} · ${defaultSector.label} · ${defaultStandards.map((standard) => standard.label).join(' + ')}`;

const baseNoSlash = import.meta.env.BASE_URL.replace(/\/+$/, '');
const quoteEstimatorScriptHref = `${baseNoSlash}/quote-estimator.js`;
const contactHref = `${baseNoSlash}/contact/`;
const intakeEndpoint = import.meta.env.PUBLIC_CANONICAL_INTAKE_URL ?? '';
---

<BaseLayout
  title="Compliance readiness quote"
  description="Build a tailored Canonical Plus readiness estimate based on company size, sector, standards, delivery speed, and service depth."
>
  <section class="page-hero section--hero bg-grid bg-radial">
    <div class="container page-hero__grid">
      <div class="page-hero__copy">
        <span class="badge">Readiness estimate</span>
        <p class="page-hero__eyebrow">Canonical Plus · readiness and pre-audit preparation</p>
        <h1 class="page-hero__title hero__title">Build a quote around <span class="gradient-text">your actual scope.</span></h1>
        <p class="page-hero__subtitle">
          Estimate readiness work using your company profile, team size, business sector, target frameworks,
          delivery speed, service depth, and environment complexity. Submit the estimate and we will email a copy to you.
        </p>
        <div class="page-hero__actions">
          <a class="btn btn--primary btn--large" href="#quote-estimator">Build my estimate</a>
          <a class="btn btn--secondary btn--large" href="mailto:hello@canonical.plus">hello@canonical.plus</a>
        </div>
        <p class="quote-financing-note">
          Flexible payment plans are available for qualified engagements. Bundled discounts may be available for full readiness programs that include pre-audit preparation and coordination with an independent audit provider.
        </p>
      </div>
      <aside class="page-hero__panel">
        <h2>What drives the estimate</h2>
        <ul>
          <li>Company stage, employee count, and business sector</li>
          <li>Target standards such as SOC 2, ISO 27001, NIST, GDPR, HIPAA, PCI DSS, FedRAMP readiness, and CIS Controls</li>
          <li>Delivery speed and the amount of hands-on remediation support</li>
          <li>Environment complexity, systems, stakeholders, and evidence footprint</li>
        </ul>
        <p>The estimate is a planning range. A reviewed scope and statement of work set final deliverables, dates, and price.</p>
      </aside>
    </div>
  </section>

  <section class="section section--compact" aria-labelledby="readiness-support-title">
    <div class="container">
      <div class="readiness-banner card">
        <div>
          <span class="badge">Readiness support</span>
          <h2 id="readiness-support-title">Canonical Plus supports readiness and pre-audit preparation.</h2>
          <p>We help organize evidence, identify gaps, plan remediation, and coordinate the path to an independent review.</p>
        </div>
        <p class="readiness-banner__boundary">Formal audit opinions, certifications, and regulatory determinations remain with the independent provider or authority responsible for them.</p>
      </div>
    </div>
  </section>

  <section class="section" id="quote-estimator" aria-labelledby="quote-estimator-title">
    <div class="container">
      <div class="section-header">
        <span class="badge">Instant estimator</span>
        <h2 id="quote-estimator-title">Build your project estimate</h2>
        <p>Adjust the inputs below, then enter your email to receive the estimate and a summary of the assumptions behind it.</p>
      </div>

      <div
        class="quote-estimator"
        data-quote-estimator
        data-schema-version={estimator.schemaVersion}
        data-currency={estimator.currency}
        data-floor={estimator.estimateFloorUsd}
        data-ceiling={estimator.estimateCeilingUsd}
        data-midpoint-floor={estimator.midpointFloorUsd}
        data-midpoint-ceiling={estimator.midpointCeilingUsd}
        data-round-to={estimator.roundToUsd}
        data-lower-factor={estimator.lowerFactor}
        data-upper-factor={estimator.upperFactor}
        data-intake-endpoint={intakeEndpoint}
      >
        <div class="quote-estimator__controls">
          <fieldset class="quote-control-card">
            <legend class="sr-only">1. Company profile</legend>
            <h3 class="quote-control-card__title">1. Company profile</h3>
            <div class="quote-profile-grid">
              <label class="quote-field">
                <span>Company stage</span>
                <select name="quote_company_stage" data-quote-stage>
                  {estimator.companyStages.map((stage) => (
                    <option value={stage.id} data-label={stage.label} data-multiplier={stage.multiplier} selected={stage.id === defaultStage.id}>{stage.label}</option>
                  ))}
                </select>
              </label>
              <label class="quote-field">
                <span>Number of employees</span>
                <input type="number" name="quote_employee_count" min="1" max="1000000" step="1" value={estimator.defaults.employeeCount} inputmode="numeric" data-quote-employees />
              </label>
              <label class="quote-field quote-field--wide">
                <span>Business sector</span>
                <select name="quote_sector" data-quote-sector>
                  {estimator.sectors.map((sector) => (
                    <option value={sector.id} data-label={sector.label} data-amount={sector.amountUsd} selected={sector.id === defaultSector.id}>{sector.label}</option>
                  ))}
                </select>
              </label>
            </div>
            <div hidden aria-hidden="true">
              {estimator.employeeBands.map((band) => (
                <span data-employee-band data-id={band.id} data-label={band.label} data-min={band.min} data-max={band.max} data-amount={band.amountUsd}></span>
              ))}
            </div>
          </fieldset>

          <fieldset class="quote-control-card">
            <legend class="sr-only">2. Delivery speed</legend>
            <h3 class="quote-control-card__title">2. Delivery speed</h3>
            <div class="quote-slider__heading">
              <span>More planning room</span>
              <strong data-speed-label>{defaultSpeed.label}</strong>
              <span>Faster delivery</span>
            </div>
            <input class="quote-slider" id="quote-speed" type="range" min="0" max={estimator.speeds.length - 1} step="1" value={defaultSpeedIndex} aria-label="Delivery speed" aria-valuetext={defaultSpeed.label} data-quote-speed-slider />
            <div class="quote-slider__ticks" aria-hidden="true">
              {estimator.speeds.map((speed) => <span>{speed.label}</span>)}
            </div>
            <p class="quote-control-note" data-speed-note>{defaultSpeed.note}</p>
            <div hidden aria-hidden="true">
              {estimator.speeds.map((speed, index) => (
                <span data-quote-speed-option data-index={index} data-weeks={speed.weeks} data-label={speed.label} data-base={speed.baseUsd} data-note={speed.note}></span>
              ))}
            </div>
          </fieldset>

          <fieldset class="quote-control-card" aria-describedby="quote-standard-note quote-standard-error">
            <legend class="sr-only">3. Standards to meet</legend>
            <h3 class="quote-control-card__title">3. Standards to meet</h3>
            <p class="quote-control-note" id="quote-standard-note">Choose at least one. Related frameworks can share evidence and remediation work, so this estimator does not simply multiply a full project price by the number selected.</p>
            <div class="quote-checkbox-grid" data-standards-group>
              {estimator.standards.map((standard) => (
                <label class="quote-check">
                  <input type="checkbox" name="quote_standard" value={standard.id} data-label={standard.label} data-amount={standard.amountUsd} checked={defaultStandardIds.has(standard.id)} />
                  <span>{standard.label}</span>
                </label>
              ))}
            </div>
            <p class="quote-validation" id="quote-standard-error" data-standard-error role="alert" hidden>Please select at least one standard.</p>
          </fieldset>

          <fieldset class="quote-control-card">
            <legend class="sr-only">4. Service depth</legend>
            <h3 class="quote-control-card__title">4. Service depth</h3>
            <div class="quote-radio-list">
              {estimator.deliveryDepths.map((depth) => (
                <label class="quote-radio">
                  <input type="radio" name="quote_delivery_depth" value={depth.id} data-label={depth.label} data-amount={depth.amountUsd} checked={depth.id === defaultDepth.id} />
                  <span><strong>{depth.label}</strong><small>{depth.note}</small></span>
                </label>
              ))}
            </div>
          </fieldset>

          <fieldset class="quote-control-card">
            <legend class="sr-only">5. Environment complexity</legend>
            <h3 class="quote-control-card__title">5. Environment complexity</h3>
            <div class="quote-radio-list">
              {estimator.complexities.map((complexity) => (
                <label class="quote-radio">
                  <input type="radio" name="quote_complexity" value={complexity.id} data-label={complexity.label} data-amount={complexity.amountUsd} checked={complexity.id === defaultComplexity.id} />
                  <span><strong>{complexity.label}</strong><small>{complexity.note}</small></span>
                </label>
              ))}
            </div>
          </fieldset>

          <fieldset class="quote-control-card">
            <legend class="sr-only">6. Send me the estimate</legend>
            <h3 class="quote-control-card__title">6. Send me the estimate</h3>
            <p class="quote-control-note">We use these details to send the quote summary and follow up on scope. A copy is sent to <strong>hello@canonical.plus</strong>.</p>
            <div class="quote-profile-grid">
              <label class="quote-field">
                <span>Your name</span>
                <input type="text" name="quote_name" maxlength="120" autocomplete="name" data-quote-name />
              </label>
              <label class="quote-field">
                <span>Company</span>
                <input type="text" name="quote_company" maxlength="200" autocomplete="organization" data-quote-company />
              </label>
              <label class="quote-field quote-field--wide">
                <span>Work email</span>
                <input type="email" name="quote_email" maxlength="320" autocomplete="email" required data-quote-email />
              </label>
              <label class="quote-honeypot" aria-hidden="true" tabindex="-1">
                <span>Website</span>
                <input type="text" name="website" autocomplete="off" tabindex="-1" data-quote-honeypot />
              </label>
            </div>
          </fieldset>
        </div>

        <aside class="quote-estimator__result" aria-live="polite" aria-atomic="true">
          <p class="quote-estimator__eyebrow">Estimated readiness range</p>
          <p class="quote-estimator__price"><strong data-quote-range>{initialRange}</strong></p>
          <p class="quote-estimator__summary" data-quote-summary>{initialSummary}</p>
          <div class="quote-estimator__meter" aria-hidden="true"><span data-quote-meter></span></div>
          <div class="quote-result-list">
            <p><strong>Includes:</strong> readiness planning, selected service depth, and the scope assumptions shown here.</p>
            <p><strong>Not included:</strong> independent auditor or certification-body fees unless a written proposal explicitly itemizes them.</p>
            <p><strong>Commercial options:</strong> payment plans and bundled readiness discounts may be available after scope review.</p>
          </div>
          <button class="btn btn--primary btn--large" type="button" data-complete-public-quote>Email my estimate</button>
          <p class="quote-submit-status" data-quote-submit-status role="status"></p>
          <p class="quote-estimator__privacy">Submitting sends your quote inputs and contact details to Canonical Plus for the purpose of delivering the estimate and discussing scope. It does not create a binding order.</p>
        </aside>
      </div>

      <section class="quote-complete" data-quote-complete hidden tabindex="-1" aria-labelledby="quote-complete-title">
        <span class="badge">Estimate ready</span>
        <h2 id="quote-complete-title">Your planning estimate is ready.</h2>
        <p class="quote-complete__range" data-completed-range></p>
        <p data-completed-summary></p>
        <p data-completed-delivery>We will email the estimate to the address you provided and copy hello@canonical.plus.</p>
        <div class="page-hero__actions">
          <a class="btn btn--primary" href={contactHref}>Talk through the scope</a>
          <a class="btn btn--secondary" href="mailto:hello@canonical.plus">hello@canonical.plus</a>
        </div>
      </section>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="badge">Ongoing readiness</span>
        <h2>Three published starting points</h2>
        <p>For teams that want continuous readiness support after the initial project, these recurring tiers provide a starting point for scoping.</p>
      </div>
      <div class="quote-tier-grid" aria-label="Canonical readiness service levels">
        {catalog.tiers.map((tier) => (
          <article class="card quote-tier-card">
            <div>
              <p class="quote-tier-card__eyebrow">{tier.name}</p>
              <p class="quote-tier-card__price"><strong>{money.format(tier.monthlyUsd)}</strong> <span>/ month</span></p>
              <p>{tier.summary}</p>
            </div>
            <ul>{tier.includes.map((item) => <li>{item}</li>)}</ul>
            <a class="btn btn--secondary" href={contactHref}>Discuss this tier</a>
          </article>
        ))}
      </div>
      <p class="quote-disclaimer">Published ranges and tier prices are planning information, not a binding offer. Final scope, line items, discounts, payment schedule, deadlines, and deliverables belong in the signed order form or statement of work.</p>
    </div>
  </section>

  <script type="module" src={quoteEstimatorScriptHref}></script>
</BaseLayout>

<style>
  .quote-financing-note { max-width: 68ch; margin-top: var(--space-md); color: var(--av-text-secondary); line-height: 1.6; }
  .readiness-banner { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(280px, .6fr); gap: var(--space-xl); align-items: center; padding: clamp(1.5rem, 4vw, 2.4rem); }
  .readiness-banner h2 { margin: .65rem 0 .55rem; }
  .readiness-banner p { margin: 0; color: var(--av-text-secondary); line-height: 1.6; }
  .readiness-banner__boundary { padding: 1rem 1.1rem; border-left: 3px solid var(--av-accent); background: color-mix(in srgb, var(--av-accent) 7%, transparent); border-radius: 0 var(--radius-md) var(--radius-md) 0; }
  .quote-estimator { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(300px, .75fr); gap: var(--space-xl); align-items: start; }
  .quote-estimator__controls { display: grid; gap: var(--space-lg); }
  .quote-control-card { margin: 0; padding: clamp(1.2rem, 2.2vw, 1.7rem); border: 1px solid var(--av-border); border-radius: var(--radius-lg); background: var(--av-surface); min-width: 0; }
  .quote-control-card__title { margin: 0 0 1rem; font-size: 1.08rem; font-weight: 820; color: var(--av-text-primary); }
  .quote-control-note { margin: 0 0 1rem; color: var(--av-text-secondary); line-height: 1.55; }
  .quote-profile-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .85rem; }
  .quote-field { display: grid; gap: .45rem; color: var(--av-text-secondary); font-size: .9rem; font-weight: 650; }
  .quote-field--wide { grid-column: 1 / -1; }
  .quote-field input, .quote-field select { width: 100%; min-height: 46px; padding: .72rem .8rem; border: 1px solid var(--av-border); border-radius: var(--radius-md); background: var(--av-surface-raised, var(--av-surface)); color: var(--av-text-primary); font: inherit; }
  .quote-field input:focus, .quote-field select:focus { outline: 2px solid var(--av-accent); outline-offset: 2px; }
  .quote-honeypot { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  .quote-slider { width: 100%; accent-color: var(--av-accent); }
  .quote-slider__heading, .quote-slider__ticks { display: grid; grid-template-columns: 1fr auto 1fr; gap: .75rem; align-items: center; }
  .quote-slider__heading { margin-bottom: .8rem; color: var(--av-text-secondary); font-size: .88rem; }
  .quote-slider__heading strong { color: var(--av-text-primary); font-size: 1.05rem; }
  .quote-slider__heading span:last-child { text-align: right; }
  .quote-slider__ticks { grid-template-columns: repeat(3, 1fr); margin-top: .35rem; color: var(--av-text-secondary); font-size: .8rem; }
  .quote-slider__ticks span:nth-child(2) { text-align: center; }
  .quote-slider__ticks span:last-child { text-align: right; }
  .quote-checkbox-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .65rem; }
  .quote-check, .quote-radio { display: flex; gap: .7rem; align-items: flex-start; padding: .8rem; border: 1px solid var(--av-border); border-radius: var(--radius-md); cursor: pointer; }
  .quote-check:hover, .quote-radio:hover { border-color: var(--av-accent); }
  .quote-check input, .quote-radio input { margin-top: .18rem; accent-color: var(--av-accent); }
  .quote-radio-list { display: grid; gap: .65rem; }
  .quote-radio span { display: grid; gap: .2rem; }
  .quote-radio small { color: var(--av-text-secondary); line-height: 1.45; }
  .quote-validation { color: #ef7b72; font-weight: 700; }
  .quote-estimator__result { position: sticky; top: 6rem; display: grid; gap: 1rem; padding: clamp(1.35rem, 3vw, 2rem); border: 1px solid var(--av-border); border-radius: var(--radius-lg); background: var(--av-surface); box-shadow: var(--shadow-lg); }
  .quote-estimator__eyebrow { margin: 0; color: var(--av-accent); font-weight: 800; text-transform: uppercase; letter-spacing: .05em; }
  .quote-estimator__price { margin: 0; }
  .quote-estimator__price strong { font-size: clamp(2rem, 5vw, 3.65rem); letter-spacing: -.04em; }
  .quote-estimator__summary, .quote-estimator__privacy { margin: 0; color: var(--av-text-secondary); line-height: 1.55; }
  .quote-estimator__meter { height: .65rem; overflow: hidden; border-radius: 999px; background: var(--av-border); }
  .quote-estimator__meter span { display: block; height: 100%; width: 50%; border-radius: inherit; background: var(--av-accent); transition: width .2s ease; }
  .quote-result-list { display: grid; gap: .55rem; padding: .9rem 0; border-top: 1px solid var(--av-border); border-bottom: 1px solid var(--av-border); }
  .quote-result-list p { margin: 0; color: var(--av-text-secondary); font-size: .9rem; line-height: 1.5; }
  .quote-result-list strong { color: var(--av-text-primary); }
  .quote-submit-status { min-height: 1.4em; margin: 0; color: var(--av-text-secondary); font-size: .9rem; }
  .quote-submit-status[data-state="error"] { color: #ef7b72; }
  .quote-submit-status[data-state="success"] { color: var(--av-accent); }
  .quote-complete { margin-top: var(--space-xl); padding: clamp(1.5rem, 4vw, 2.5rem); border: 1px solid var(--av-border); border-radius: var(--radius-lg); background: var(--av-surface); }
  .quote-complete__range { font-size: clamp(2rem, 5vw, 3.2rem); font-weight: 850; letter-spacing: -.04em; }
  .quote-tier-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-lg); align-items: stretch; }
  .quote-tier-card { display: flex; flex-direction: column; justify-content: space-between; gap: var(--space-lg); }
  .quote-tier-card__eyebrow { margin: 0; color: var(--av-accent); font-weight: 750; letter-spacing: .04em; text-transform: uppercase; }
  .quote-tier-card__price { margin: .5rem 0 1rem; }
  .quote-tier-card__price strong { font-size: clamp(2rem, 4vw, 3rem); }
  .quote-tier-card__price span, .quote-tier-card p, .quote-tier-card li, .quote-disclaimer { color: var(--av-text-secondary); }
  .quote-tier-card ul { display: grid; gap: .65rem; padding-left: 1.2rem; }
  .quote-disclaimer { margin-top: var(--space-xl); line-height: 1.6; }
  @media (max-width: 900px) {
    .readiness-banner, .quote-estimator, .quote-tier-grid { grid-template-columns: 1fr; }
    .quote-estimator__result { position: static; }
  }
  @media (max-width: 620px) {
    .quote-profile-grid, .quote-checkbox-grid { grid-template-columns: 1fr; }
    .quote-field--wide { grid-column: auto; }
    .quote-slider__heading span { display: none; }
    .quote-slider__heading { grid-template-columns: 1fr; }
  }
</style>
