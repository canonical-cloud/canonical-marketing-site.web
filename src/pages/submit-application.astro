---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
import '../styles/marketing-pages.css';
import '../styles/public-intake.css';

const quoteHref = 'https://user.canonical.plus/u/quote';
const individualHref = 'https://user.canonical.plus/pre-interest';
const formAction = '/forms/pre-interest';
const interestAreas = [
  ['readiness_assessment', 'Readiness assessment'],
  ['soc2', 'SOC 2'],
  ['iso_27001', 'ISO 27001'],
  ['hipaa', 'HIPAA'],
  ['pci_dss_4', 'PCI DSS 4'],
  ['fedramp', 'FedRAMP'],
  ['nist', 'NIST'],
  ['gdpr', 'GDPR'],
  ['cmmc', 'CMMC'],
];
---

<BaseLayout
  title="Submit an organization application"
  description="Submit a bounded organization application to Canonical Plus without creating an account or automatically submitting a quote."
>
  <section class="page-hero section--hero bg-grid bg-radial">
    <div class="container intake-shell">
      <header class="intake-header">
        <span class="badge">Organization application</span>
        <h1>Apply for Canonical Plus readiness support</h1>
        <p>
          This records an organization’s interest and preferred framework areas. It is not an
          engagement agreement, account creation, quote submission, audit, certification, or
          authorization decision.
        </p>
      </header>

      <div class="intake-grid">
        <form
          class="intake-form"
          action={formAction}
          method="post"
          accept-charset="UTF-8"
          data-public-intake-form="organization"
          data-required-host="org.canonical.plus"
          aria-describedby="application-boundary"
        >
          <input type="hidden" name="consentRevision" value="pre-interest-v1" />
          <input type="hidden" name="marketingConsentCopyRevision" value="marketing-v1" />

          <div class="intake-field">
            <label for="application-organization">Organization name <span aria-hidden="true">*</span></label>
            <input
              id="application-organization"
              name="organizationName"
              type="text"
              autocomplete="organization"
              maxlength="200"
              required
            />
          </div>

          <div class="intake-field">
            <label for="application-email">Work email <span aria-hidden="true">*</span></label>
            <input
              id="application-email"
              name="email"
              type="email"
              autocomplete="email"
              inputmode="email"
              maxlength="320"
              required
            />
          </div>

          <div class="intake-field">
            <label for="application-name">Contact name <span class="intake-optional">(optional)</span></label>
            <input
              id="application-name"
              name="displayName"
              type="text"
              autocomplete="name"
              maxlength="120"
            />
          </div>

          <div class="intake-field">
            <label for="application-website">Organization website <span class="intake-optional">(optional)</span></label>
            <input
              id="application-website"
              name="websiteUrl"
              type="url"
              inputmode="url"
              autocomplete="url"
              maxlength="2048"
              placeholder="https://example.org"
              pattern="https://.*"
            />
          </div>

          <fieldset class="intake-fieldset">
            <legend>Framework or readiness interests <span aria-hidden="true">*</span></legend>
            <p class="intake-help" id="organization-interest-help">Choose one or more bounded categories. The server rejects an empty selection.</p>
            <div class="intake-options" aria-describedby="organization-interest-help">
              {interestAreas.map(([value, label]) => (
                <label class="intake-option">
                  <input
                    type="checkbox"
                    name="interestAreas"
                    value={value}
                  />
                  <span>{label}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <div class="intake-consent">
            <label class="intake-choice">
              <input
                type="checkbox"
                name="registrationConsent"
                value="true"
                required
              />
              <span>
                I am authorized to submit this organization application and consent to Canonical
                Plus storing it and contacting the organization about the selected interests.
                This consent is separate from any future quote.
              </span>
            </label>
          </div>

          <fieldset class="intake-fieldset">
            <legend>Marketing permission <span aria-hidden="true">*</span></legend>
            <p class="intake-help">
              Choose explicitly. Declining does not prevent this application from being accepted.
            </p>
            <div class="intake-radio-row">
              <label class="intake-choice">
                <input type="radio" name="marketingPermission" value="yes" required />
                <span>Yes, send occasional product updates.</span>
              </label>
              <label class="intake-choice">
                <input type="radio" name="marketingPermission" value="no" required />
                <span>No marketing messages.</span>
              </label>
            </div>
          </fieldset>

          <p id="application-boundary" class="intake-boundary">
            The same-origin organization BFF derives the verified host, party type, acceptance
            time, and opaque idempotency identifier before calling the bearer API. It must not
            forward contact data into URLs, logs, metrics, traces, or idempotency keys.
          </p>

          <button class="btn btn--primary btn--large" type="submit">
            Submit organization application
          </button>
        </form>

        <aside class="intake-aside">
          <h2>Applying as an individual?</h2>
          <p>Use the shorter individual pre-interest route instead.</p>
          <a class="btn btn--secondary" href={individualHref}>Register individual interest</a>

          <hr />

          <h2>Already ready for scoping?</h2>
          <p>An accepted application does not start the quote automatically.</p>
          <a class="btn btn--secondary" href={quoteHref} data-application-link="quote">
            Open the existing quote flow
          </a>
        </aside>
      </div>

      <noscript>
        <p class="intake-noscript">
          JavaScript is not required. This form uses a normal HTTPS POST to the same-origin
          Canonical organization BFF.
        </p>
      </noscript>
    </div>
  </section>
</BaseLayout>
