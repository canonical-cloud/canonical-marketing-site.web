---
import BaseLayout from '../layouts/BaseLayout.astro';
import PeopleGrid from '../components/PeopleGrid.astro';
import TestimonialsGrid from '../components/TestimonialsGrid.astro';
import '../styles/global.css';
import '../styles/marketing-pages.css';
import '../styles/audience-pages.css';
import { audienceLinks } from '../data/audiences';

const baseNoSlash = import.meta.env.BASE_URL.replace(/\/+$/, '');
const readinessHref = `${baseNoSlash}/readiness/`;
const startupsHref = `${baseNoSlash}/startups/`;
const frameworksHref = `${baseNoSlash}/frameworks/`;
const compareHref = `${baseNoSlash}/compare/`;
const faqHref = `${baseNoSlash}/faq/`;
const quoteHref = 'https://app.canonical.plus/u/quote';
const introHref = 'https://calendly.com/hello-canonical/30min';

const featuredFaqs = [
  ['faq-why-preaudit', 'Why do I need a readiness assessment or pre-audit?'],
  ['faq-why-canonical-plus', 'Why choose Canonical instead of another company?'],
  ['faq-why-not-auditor', 'Why not go straight to an auditor?'],
  ['faq-vanta-drata', 'How is Canonical different from Vanta or Drata?'],
  ['faq-fix-issues', 'Will Canonical actually help fix issues?'],
  ['faq-deliverables', 'What deliverables will we receive?'],
  ['faq-pricing', 'How much does Canonical cost?'],
  ['faq-guarantee', 'Can Canonical guarantee an audit result?'],
];

const featuredFrameworks = [
  ['SOC 2', 'Trust Services Criteria readiness'],
  ['ISO 27001', 'Information security management'],
  ['HIPAA', 'Healthcare security and privacy'],
  ['NIST CSF 2.0', 'Cybersecurity program maturity'],
  ['GDPR', 'Privacy and data-protection operations'],
  ['PCI DSS 4.0', 'Payment-card security controls'],
  ['CMMC 2.0', 'Defense supply-chain readiness'],
  ['CSA CCM', 'Cloud control assurance mapping'],
];
---

<BaseLayout
  title="Startup security and compliance readiness"
  description="Security and compliance readiness for seed-stage B2B startups. Clarify customer requirements, prioritize technical remediation, and prepare evidence for independent review."
>
  <section class="page-hero section--hero bg-grid bg-radial" id="hero">
    <div class="container page-hero__grid">
      <div class="page-hero__copy">
        <div class="badge animate-fade-in-up">
          <span class="badge__dot" aria-hidden="true"></span>
          Compliance readiness for growing startups
        </div>

        <p class="page-hero__eyebrow animate-fade-in-up stagger-1">
          Built for seed-stage and growing B2B teams
        </p>

        <h1 class="page-hero__title hero__title animate-fade-in-up stagger-2">
          Enterprise-ready security for startups
          <span class="gradient-text">that need to move fast.</span>
        </h1>

        <p class="page-hero__subtitle animate-fade-in-up stagger-2">
          When an enterprise customer asks about SOC 2, security controls, or evidence, a small
          team needs a practical next step. Canonical Plus scopes requirements, identifies
          gaps, and prioritizes remediation while your team keeps building. Qualified
          independent parties—not Canonical Plus—perform formal audits and certifications.
        </p>

        <div class="page-hero__actions animate-fade-in-up stagger-3">
          <a
            href={quoteHref}
            class="btn btn--primary btn--large"
            id="hero-cta-primary"
            data-application-link="quote"
          >
            Start readiness assessment
          </a>
          <a href={startupsHref} class="btn btn--secondary btn--large" id="hero-cta-secondary">
            For seed-stage startups
          </a>
          <a href={introHref} class="btn btn--secondary btn--large" id="hero-cta-book-intro" target="_blank" rel="noopener noreferrer">
            Book an intro
          </a>
        </div>
      </div>

      <aside class="page-hero__panel animate-fade-in-up stagger-3" aria-label="Readiness assessment outputs">
        <h2>Give your next security review a clear starting point</h2>
        <ul class="check-list">
          <li>A clear scope and target-framework map</li>
          <li>A gap register tied to controls and evidence</li>
          <li>A prioritized remediation roadmap with owners</li>
          <li>An evidence plan for independent assessor review</li>
        </ul>
        <p class="boundary-note">
          The assessment is preliminary and customer-specific. It is not an attestation,
          certification, authorization, legal opinion, or guarantee of audit outcome.
        </p>
      </aside>
    </div>
  </section>

  <section class="outcome-strip" aria-label="Readiness deliverables">
    <div class="container outcome-strip__grid">
      <div class="outcome-strip__item"><strong>Gap map</strong><span>What is missing or not yet evidenced</span></div>
      <div class="outcome-strip__item"><strong>Control roadmap</strong><span>What to implement, in what order, and why</span></div>
      <div class="outcome-strip__item"><strong>Evidence plan</strong><span>What an independent reviewer is likely to request</span></div>
      <div class="outcome-strip__item"><strong>Handoff boundary</strong><span>What Canonical prepares versus what an assessor decides</span></div>
    </div>
  </section>

  <section class="section audience-home" id="who-we-help" aria-labelledby="who-we-help-heading">
    <div class="container">
      <header class="section-header">
        <span class="badge">For the teams moving the deal forward</span>
        <h2 id="who-we-help-heading">Security readiness is a business priority, not just a CTO task.</h2>
        <p>Founders, engineers, sales leaders, and portfolio operators see different problems. We connect customer requirements to scoped readiness work without assuming every startup needs a full compliance program.</p>
      </header>
      <div class="audience-link-grid">
        {audienceLinks.map((link) => (
          <a class="audience-route" href={`${baseNoSlash}/${link.slug}/`}>
            <strong>{link.label} <span aria-hidden="true">↗</span></strong>
            <span>{link.teaser}</span>
          </a>
        ))}
      </div>
      <div class="action-row">
        <a href={startupsHref} class="btn btn--secondary">Explore startup readiness</a>
        <a href={readinessHref} class="btn btn--secondary">See readiness deliverables</a>
      </div>
    </div>
  </section>

  <section class="section" id="readiness-preview" aria-labelledby="readiness-preview-title">
    <div class="container">
      <header class="section-header">
        <span class="badge">What you receive</span>
        <h2 id="readiness-preview-title">Find the gaps before your independent reviewer does</h2>
        <p>A readiness engagement turns uncertainty into reviewable work, not an audit opinion or a generic dashboard score. Your actual deliverables depend on the agreed scope.</p>
      </header>
      <div class="readiness-preview-grid">
        <article class="readiness-preview-item">
          <span class="readiness-preview-item__index" aria-hidden="true">01</span>
          <h3>Scope map</h3>
          <p>Systems, data flows, framework targets, boundaries, and exclusions.</p>
        </article>
        <article class="readiness-preview-item">
          <span class="readiness-preview-item__index" aria-hidden="true">02</span>
          <h3>Gap register</h3>
          <p>Missing or incomplete controls, missing evidence, assumptions, and risks.</p>
        </article>
        <article class="readiness-preview-item">
          <span class="readiness-preview-item__index" aria-hidden="true">03</span>
          <h3>Remediation roadmap</h3>
          <p>Prioritized engineering actions with owners, dependencies, and acceptance criteria.</p>
        </article>
        <article class="readiness-preview-item">
          <span class="readiness-preview-item__index" aria-hidden="true">04</span>
          <h3>Evidence-readiness index</h3>
          <p>Artifact sources, freshness, open questions, and independent-review handoff needs.</p>
        </article>
      </div>
      <div class="action-row">
        <a class="btn btn--secondary" href={`${readinessHref}#sample-finding`} id="preview-sample-link">View an illustrative finding</a>
        <a class="btn btn--secondary" href={readinessHref}>Explore readiness deliverables</a>
      </div>
    </div>
  </section>

  <section class="section services" id="services">
    <div class="container">
      <header class="section-header section-header--center">
        <span class="badge animate-fade-in-up">What we deliver</span>
        <h2 class="animate-fade-in-up stagger-1">A readiness program your engineering team can <span class="gradient-text">actually execute</span></h2>
        <p class="animate-fade-in-up stagger-2">The initial focus is readiness and remediation. Independent audit, certification, authorization, or legal work remains with qualified third parties.</p>
      </header>
      <div class="card-grid services__grid">
        <article class="card service-card services__card animate-fade-in-up stagger-1"><span class="service-card__number">01</span><h3>Readiness assessment</h3><p>Scope the target framework, systems, data, people, vendors, and current program maturity.</p><ul><li>Framework and system boundary</li><li>Control and evidence gap register</li><li>Readiness risks and dependencies</li></ul></article>
        <article class="card service-card services__card animate-fade-in-up stagger-2"><span class="service-card__number">02</span><h3>Technical remediation roadmap</h3><p>Turn gaps into concrete engineering, policy, ownership, and operating tasks.</p><ul><li>Prioritized implementation sequence</li><li>Cloud, identity, SDLC, and data controls</li><li>Owners, acceptance criteria, and evidence</li></ul></article>
        <article class="card service-card services__card animate-fade-in-up stagger-3"><span class="service-card__number">03</span><h3>Evidence operations</h3><p>Define durable evidence sources so teams do not rebuild the same package for every review.</p><ul><li>Evidence inventory and freshness rules</li><li>Cross-framework control mapping</li><li>Exception and remediation tracking</li></ul></article>
        <article class="card service-card services__card animate-fade-in-up stagger-4"><span class="service-card__number">04</span><h3>Independent-review handoff</h3><p>Prepare a structured package and coordinate open questions without blurring independence.</p><ul><li>Assessor-ready scope and evidence index</li><li>Responsibility and independence matrix</li><li>Findings-to-remediation workflow</li></ul></article>
      </div>
    </div>
  </section>

  <section class="section bg-noise" id="process">
    <div class="container" style="position: relative; z-index: 1;">
      <header class="section-header"><span class="badge animate-fade-in-up">How it works</span><h2 class="animate-fade-in-up stagger-1">Readiness before <span class="gradient-text">assurance</span></h2><p class="animate-fade-in-up stagger-2">Each phase produces a reviewable artifact. No phase silently converts a readiness recommendation into an independent conclusion.</p></header>
      <div class="process-list">
        <article class="process-step animate-fade-in-up stagger-1"><div><h3>Scope the real system</h3><p>Choose target frameworks and define products, cloud accounts, data, vendors, and organizational boundaries.</p></div></article>
        <article class="process-step animate-fade-in-up stagger-2"><div><h3>Assess controls and evidence</h3><p>Map current practices to requirements, distinguish missing controls from missing proof, and record assumptions.</p></div></article>
        <article class="process-step animate-fade-in-up stagger-3"><div><h3>Remediate by risk and dependency</h3><p>Sequence the work, assign owners, define acceptance criteria, and keep exceptions explicit.</p></div></article>
        <article class="process-step animate-fade-in-up stagger-4"><div><h3>Prepare the independent handoff</h3><p>Package scope, controls, evidence, exceptions, and open questions for the qualified reviewer you select.</p></div></article>
      </div>
    </div>
  </section>

  <section class="section" id="frameworks">
    <div class="container">
      <header class="section-header section-header--center"><span class="badge animate-fade-in-up">Framework coverage</span><h2 class="animate-fade-in-up stagger-1">Start with the obligations that matter to <span class="gradient-text">your customers and market</span></h2><p class="animate-fade-in-up stagger-2">Canonical Plus can scope readiness across overlapping security, privacy, cloud, payment, healthcare, and public-sector requirements.</p></header>
      <div class="frameworks__grid">{featuredFrameworks.map(([name, scope], index) => (<article class={`frameworks__item animate-fade-in-up stagger-${(index % 6) + 1}`}><h4>{name}</h4><p>{scope}</p></article>))}</div>
      <div class="action-row" style="justify-content: center;"><a href={frameworksHref} class="btn btn--secondary">View the full framework catalog</a></div>
    </div>
  </section>

  <section class="section" id="about"><div class="container"><header class="section-header"><span class="badge animate-fade-in-up">Why Canonical Plus</span><h2 class="animate-fade-in-up stagger-1">Honest boundaries and <span class="gradient-text">technical depth</span></h2></header><div class="why__grid"><article class="why__item animate-fade-in-up stagger-1"><div class="why__number">01</div><h4>Readiness before assurance</h4><p>We separate preparation from the independent decision so buyers know exactly what they are purchasing.</p></article><article class="why__item animate-fade-in-up stagger-2"><div class="why__number">02</div><h4>Engineering-aware remediation</h4><p>Findings become implementation work across cloud, identity, software delivery, data, and operations.</p></article><article class="why__item animate-fade-in-up stagger-3"><div class="why__number">03</div><h4>Reusable control mapping</h4><p>Shared controls and evidence are mapped across frameworks instead of recreated for each new requirement.</p></article><article class="why__item animate-fade-in-up stagger-4"><div class="why__number">04</div><h4>Transparent platform fit</h4><p>We say when a full automation platform, audit firm, certification body, or legal adviser is the better next step.</p></article></div><div class="action-row"><a href={compareHref} class="btn btn--secondary">Compare approaches</a></div></div></section>

  <TestimonialsGrid />

  <section class="section" id="people" aria-labelledby="team-title"><div class="container"><header class="section-header section-header--center"><span class="badge">Our people</span><h2 id="team-title">The people behind <span class="gradient-text">your readiness</span></h2><p>Engineering, security, infrastructure, business, and legal perspectives on the same team.</p></header><PeopleGrid /></div></section>


  <section class="section" id="faq-preview" aria-labelledby="faq-preview-title">
    <div class="container">
      <header class="section-header">
        <span class="badge">Frequently asked questions</span>
        <h2 id="faq-preview-title">Answers before you commit to readiness</h2>
        <p>What does a pre-audit do, why choose Canonical, and what should your team expect? Start with the questions other buyers ask.</p>
      </header>
      <div class="card-grid card-grid--two">
        {featuredFaqs.map(([id, question]) => (
          <article class="card">
            <h3><a href={`${faqHref}#${id}`}>{question}</a></h3>
          </article>
        ))}
      </div>
      <div class="action-row">
        <a class="btn btn--secondary" href={faqHref} id="all-faqs-link">Read all 68 FAQs</a>
      </div>
    </div>
  </section>

  <section class="section" id="contact"><div class="container"><div class="cta-panel animate-fade-in-up"><span class="badge">Start with scope</span><h2>Get a scoped plan for your next security review</h2><p>Bring the customer requirement, your current systems, and the gaps you know about. Start with a preliminary estimate; final scope and price are defined in a signed statement of work, not an audit opinion or certification.</p><div class="action-row"><a href={quoteHref} class="btn btn--primary btn--large" id="cta-readiness-btn" data-application-link="quote">Start readiness assessment</a><a href="mailto:hello@canonical.plus" class="btn btn--secondary btn--large" id="cta-contact-btn">Discuss your scope</a></div></div></div></section>
</BaseLayout>

<style>
  .badge__dot { width: 6px; height: 6px; border-radius: 50%; background: var(--av-success); display: inline-block; }
</style>
