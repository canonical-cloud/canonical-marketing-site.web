---
import BaseLayout from '../layouts/BaseLayout.astro';
import PeopleGrid from '../components/PeopleGrid.astro';
import '../styles/global.css';
import '../styles/marketing-pages.css';

const baseNoSlash = import.meta.env.BASE_URL.replace(/\/+$/, '');
const readinessHref = `${baseNoSlash}/readiness/`;
const frameworksHref = `${baseNoSlash}/frameworks/`;
const compareHref = `${baseNoSlash}/compare/`;
const quoteHref = `${baseNoSlash}/quote/`;
const contactHref = `${baseNoSlash}/contact/`;

const featuredFrameworks = [
  ['SOC 2', 'Trust Services Criteria readiness'],
  ['ISO 27001', 'Information security management'],
  ['HIPAA', 'Healthcare security and privacy'],
  ['NIST CSF 2.0', 'Cybersecurity program maturity'],
  ['GDPR', 'Privacy and data-protection operations'],
  ['PCI DSS 4.0', 'Payment-card security controls'],
  ['CMMC 2.0', 'Defense supply-chain readiness'],
  ['CSA CCM', 'Cloud control assurance mapping'],
];
---

<BaseLayout
  title="Compliance readiness for software teams"
  description="Canonical Plus helps software and cloud teams assess compliance readiness, prioritize technical remediation, organize evidence, and prepare for independent reviews."
>
  <section class="page-hero section--hero bg-grid bg-radial" id="hero">
    <div class="container page-hero__grid">
      <div class="page-hero__copy">
        <div class="badge animate-fade-in-up">
          <span class="badge__dot" aria-hidden="true"></span>
          Readiness and pre-audit preparation
        </div>

        <p class="page-hero__eyebrow animate-fade-in-up stagger-1">
          Built for software, SaaS, and cloud teams
        </p>

        <h1 class="page-hero__title hero__title animate-fade-in-up stagger-2">
          Know what stands between you and
          <span class="gradient-text">audit-ready.</span>
        </h1>

        <p class="page-hero__subtitle animate-fade-in-up stagger-2">
          Canonical Plus turns framework requirements into a scoped readiness program: control gaps,
          evidence priorities, remediation work, owners, and an organized path to independent review.
        </p>

        <div class="page-hero__actions animate-fade-in-up stagger-3">
          <a href={quoteHref} class="btn btn--primary btn--large" id="hero-cta-primary">Build a readiness quote</a>
          <a href={contactHref} class="btn btn--secondary btn--large" id="hero-cta-secondary">Talk to Canonical Plus</a>
        </div>
        <p class="hero-commercial-note">Payment plans and bundled discounts may be available for qualified full-readiness programs.</p>
      </div>

      <aside class="page-hero__panel animate-fade-in-up stagger-3" aria-label="Readiness assessment outputs">
        <h2>What a useful readiness program produces</h2>
        <ul class="check-list">
          <li>A clear scope and target-framework map</li>
          <li>A gap register tied to controls and evidence</li>
          <li>A prioritized remediation roadmap with owners</li>
          <li>An evidence package prepared for independent review</li>
        </ul>
        <p class="boundary-note">
          When formal assurance or certification is required, the qualified independent auditor,
          assessor, certification body, or authority remains responsible for its own determination.
        </p>
      </aside>
    </div>
  </section>

  <section class="outcome-strip" aria-label="Readiness deliverables">
    <div class="container outcome-strip__grid">
      <div class="outcome-strip__item"><strong>Gap map</strong><span>What is missing or not yet evidenced</span></div>
      <div class="outcome-strip__item"><strong>Control roadmap</strong><span>What to implement, in what order, and why</span></div>
      <div class="outcome-strip__item"><strong>Evidence plan</strong><span>What an independent reviewer is likely to request</span></div>
      <div class="outcome-strip__item"><strong>Review handoff</strong><span>A structured package for the reviewer you select</span></div>
    </div>
  </section>

  <section class="section services" id="services">
    <div class="container">
      <header class="section-header section-header--center">
        <span class="badge animate-fade-in-up">What we deliver</span>
        <h2 class="animate-fade-in-up stagger-1">A readiness program your engineering team can <span class="gradient-text">actually execute</span></h2>
        <p class="animate-fade-in-up stagger-2">From initial scope through remediation and evidence preparation, each workstream is tied to owners, deliverables, and reviewable outcomes.</p>
      </header>
      <div class="card-grid services__grid">
        <article class="card service-card services__card animate-fade-in-up stagger-1"><span class="service-card__number">01</span><h3>Readiness assessment</h3><p>Scope the target framework, systems, data, people, vendors, and current program maturity.</p><ul><li>Framework and system boundary</li><li>Control and evidence gap register</li><li>Readiness risks and dependencies</li></ul></article>
        <article class="card service-card services__card animate-fade-in-up stagger-2"><span class="service-card__number">02</span><h3>Technical remediation</h3><p>Turn gaps into concrete engineering, policy, ownership, and operating work.</p><ul><li>Prioritized implementation sequence</li><li>Cloud, identity, SDLC, and data controls</li><li>Owners, acceptance criteria, and evidence</li></ul></article>
        <article class="card service-card services__card animate-fade-in-up stagger-3"><span class="service-card__number">03</span><h3>Evidence operations</h3><p>Build durable evidence sources so teams do not recreate the same package for every review.</p><ul><li>Evidence inventory and freshness rules</li><li>Cross-framework control mapping</li><li>Exception and remediation tracking</li></ul></article>
        <article class="card service-card services__card animate-fade-in-up stagger-4"><span class="service-card__number">04</span><h3>Independent-review coordination</h3><p>Prepare a structured package and coordinate open questions with the qualified reviewer you engage.</p><ul><li>Reviewer-ready scope and evidence index</li><li>Responsibility and independence matrix</li><li>Findings-to-remediation workflow</li></ul></article>
      </div>
    </div>
  </section>

  <section class="section bg-noise" id="process">
    <div class="container" style="position: relative; z-index: 1;">
      <header class="section-header"><span class="badge animate-fade-in-up">How it works</span><h2 class="animate-fade-in-up stagger-1">From scope to <span class="gradient-text">review-ready evidence</span></h2><p class="animate-fade-in-up stagger-2">Each phase produces concrete artifacts your team can use, review, and carry into the next stage.</p></header>
      <div class="process-list">
        <article class="process-step animate-fade-in-up stagger-1"><div><h3>Scope the real system</h3><p>Choose target frameworks and define products, cloud accounts, data, vendors, and organizational boundaries.</p></div></article>
        <article class="process-step animate-fade-in-up stagger-2"><div><h3>Assess controls and evidence</h3><p>Map current practices to requirements, distinguish missing controls from missing proof, and record assumptions.</p></div></article>
        <article class="process-step animate-fade-in-up stagger-3"><div><h3>Remediate by risk and dependency</h3><p>Sequence the work, assign owners, define acceptance criteria, and keep exceptions explicit.</p></div></article>
        <article class="process-step animate-fade-in-up stagger-4"><div><h3>Prepare the independent handoff</h3><p>Package scope, controls, evidence, exceptions, and open questions for the qualified reviewer you select.</p></div></article>
      </div>
    </div>
  </section>

  <section class="section" id="frameworks">
    <div class="container">
      <header class="section-header section-header--center"><span class="badge animate-fade-in-up">Framework coverage</span><h2 class="animate-fade-in-up stagger-1">Start with the obligations that matter to <span class="gradient-text">your customers and market</span></h2><p class="animate-fade-in-up stagger-2">Canonical Plus can scope readiness across overlapping security, privacy, cloud, payment, healthcare, and public-sector requirements.</p></header>
      <div class="frameworks__grid">{featuredFrameworks.map(([name, scope], index) => (<article class={`frameworks__item animate-fade-in-up stagger-${(index % 6) + 1}`}><h4>{name}</h4><p>{scope}</p></article>))}</div>
      <div class="action-row" style="justify-content: center;"><a href={frameworksHref} class="btn btn--secondary">View the full framework catalog</a></div>
    </div>
  </section>

  <section class="section" id="about"><div class="container"><header class="section-header"><span class="badge animate-fade-in-up">Why Canonical Plus</span><h2 class="animate-fade-in-up stagger-1">Technical depth with <span class="gradient-text">clear commercial scope</span></h2></header><div class="why__grid"><article class="why__item animate-fade-in-up stagger-1"><div class="why__number">01</div><h4>Buyer-ready scoping</h4><p>Company size, frameworks, delivery speed, service depth, and complexity become a transparent project range.</p></article><article class="why__item animate-fade-in-up stagger-2"><div class="why__number">02</div><h4>Engineering-aware remediation</h4><p>Findings become implementation work across cloud, identity, software delivery, data, and operations.</p></article><article class="why__item animate-fade-in-up stagger-3"><div class="why__number">03</div><h4>Reusable control mapping</h4><p>Shared controls and evidence are mapped across frameworks instead of recreated for each new requirement.</p></article><article class="why__item animate-fade-in-up stagger-4"><div class="why__number">04</div><h4>Flexible engagement structure</h4><p>Readiness, remediation, recurring support, payment schedules, and independent-review coordination can be itemized in the scope.</p></article></div><div class="action-row"><a href={compareHref} class="btn btn--secondary">Compare approaches</a></div></div></section>

  <section class="section" id="people" aria-labelledby="team-title"><div class="container"><header class="section-header section-header--center"><span class="badge">Our people</span><h2 id="team-title">The people behind <span class="gradient-text">your readiness</span></h2><p>Engineering, security, infrastructure, business, and legal perspectives on the same team.</p></header><PeopleGrid /></div></section>

  <section class="section" id="contact"><div class="container"><div class="cta-panel animate-fade-in-up"><span class="badge">Start with scope</span><h2>Get a tailored readiness estimate</h2><p>Choose your company profile, frameworks, delivery pace, and service depth. We will email the estimate and can turn it into an itemized statement of work after scope review.</p><div class="action-row"><a href={quoteHref} class="btn btn--primary btn--large" id="cta-readiness-btn">Build a readiness quote</a><a href="mailto:hello@canonical.plus" class="btn btn--secondary btn--large" id="cta-contact-btn">hello@canonical.plus</a></div></div></div></section>
</BaseLayout>

<style>
  .badge__dot { width: 6px; height: 6px; border-radius: 50%; background: var(--av-success); display: inline-block; }
  .hero-commercial-note { max-width: 66ch; margin-top: var(--space-md); color: var(--av-text-secondary); font-size: .92rem; line-height: 1.55; }
</style>
