---
import BaseLayout from '../layouts/BaseLayout.astro';
import catalog from '../data/service-tiers.json';
import '../styles/global.css';
import '../styles/marketing-pages.css';

const baseNoSlash = import.meta.env.BASE_URL.replace(/\/+$/, '');
const frameworksHref = `${baseNoSlash}/frameworks/`;
const compareHref = `${baseNoSlash}/compare/`;
const pricingHref = `${baseNoSlash}/pricing/`;
const baseNoSlash = import.meta.env.BASE_URL.replace(/\\\/+$/, '');\nconst quoteHref = `${baseNoSlash}/quote/`;
const money = new Intl.NumberFormat('en-US', {
  style: 'currency',
  currency: catalog.source.currency,
  maximumFractionDigits: 0,
});

const deliverables = [
  ['Scope memo', 'Systems, products, data, people, vendors, locations, and exclusions that define the readiness boundary.'],
  ['Control map', 'Target requirements mapped to current controls, owners, evidence sources, and known exceptions.'],
  ['Gap register', 'Missing, partial, stale, or unverified controls and evidence, with assumptions kept visible.'],
  ['Remediation roadmap', 'Prioritized work with dependencies, owners, acceptance criteria, and evidence expectations.'],
  ['Evidence index', 'A durable inventory of artifacts, systems of record, freshness windows, and access constraints.'],
  ['Independent-review handoff', 'A package for the qualified auditor, assessor, certification body, or other reviewer you select.'],
];
---

<BaseLayout
  title="Compliance readiness assessment"
  description="Understand the difference between compliance readiness and an independent audit, see Canonical Plus readiness pricing, and review the artifacts prepared for software and cloud teams."
>
  <section class="page-hero section--hero bg-grid bg-radial">
    <div class="container page-hero__grid">
      <div class="page-hero__copy">
        <span class="badge animate-fade-in-up">Readiness assessment</span>
        <p class="page-hero__eyebrow animate-fade-in-up stagger-1">Preparation with explicit boundaries</p>
        <h1 class="page-hero__title animate-fade-in-up stagger-2">
          Move from first gap scan to
          <span class="gradient-text">pre-audit readiness</span>
        </h1>
        <p class="page-hero__subtitle animate-fade-in-up stagger-2">
          Align scope, controls, evidence, ownership, and remediation before formal review begins.
          When an audit or certification is required, the qualified independent provider runs that engagement
          performed by a qualified party under its own rules.
        </p>
        <div class="page-hero__actions animate-fade-in-up stagger-3">
          <a href={quoteHref} class="btn btn--primary btn--large" data-application-link="quote">
            Start readiness assessment
          </a>
          <a href={pricingHref} class="btn btn--secondary btn--large">View pricing</a>
          <a href={frameworksHref} class="btn btn--secondary btn--large">Choose a framework</a>
        </div>
      </div>

      <aside class="page-hero__panel animate-fade-in-up stagger-3">
        <h2>Readiness is useful when you need to</h2>
        <ul class="check-list">
          <li>Choose the right first framework or combination</li>
          <li>Understand what engineering work is actually required</li>
          <li>Separate missing controls from missing evidence</li>
          <li>Prepare for an auditor, assessor, customer, or regulator</li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="section" aria-labelledby="readiness-pricing-title">
    <div class="container">
      <header class="section-header section-header--center">
        <span class="badge">Readiness pricing</span>
        <h2 id="readiness-pricing-title">Three levels of readiness support</h2>
        <p>
          These are <strong>{catalog.source.publicationStatus}</strong> starting assumptions in
          {catalog.source.currency}, current as of {catalog.source.asOf}. Final scope, price,
          allowances, dependencies, term, and billing are controlled by the signed statement of work.
        </p>
      </header>

      <div class="readiness-pricing-grid">
        {catalog.tiers.map((tier, index) => (
          <article class={`card readiness-pricing-card ${index === 1 ? 'readiness-pricing-card--featured' : ''}`}>
            <span class="readiness-pricing-card__number">{String(index + 1).padStart(2, '0')}</span>
            <h3>{tier.name}</h3>
            <p class="readiness-pricing-card__price">
              <strong>{money.format(tier.monthlyUsd)}</strong>
              <span>/ month starting assumption</span>
            </p>
            <p>{tier.summary}</p>
            <p><strong>Best fit:</strong> {tier.idealFor}</p>
            <ul class="check-list">
              {tier.includes.map((item) => <li>{item}</li>)}
            </ul>
          </article>
        ))}
      </div>

      <div class="action-row readiness-pricing-actions">
        <a href={pricingHref} class="btn btn--secondary btn--large">Full pricing details</a>
        <a href={quoteHref} class="btn btn--primary btn--large" data-application-link="quote">
          Scope a readiness engagement
        </a>
      </div>

      <p class="boundary-note readiness-pricing-boundary">
        Canonical Plus readiness packages do not promise an audit opinion, certification,
        authorization, legal conclusion, or successful outcome from an independent reviewer.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <header class="section-header section-header--center">
        <span class="badge">Know what you are buying</span>
        <h2>Prepare the work, then hand off cleanly for independent assurance</h2>
      </header>

      <div class="definition-grid">
        <article class="definition-card definition-card--positive">
          <h3>Canonical Plus readiness</h3>
          <p>
            Scopes the program, maps requirements, identifies gaps, prioritizes remediation,
            and prepares an evidence package.
          </p>
          <p>
            The output is management and implementation guidance. It can support an independent
            review, but it is not the reviewer’s conclusion.
          </p>
        </article>
        <article class="definition-card definition-card--independent">
          <h3>Independent audit, assessment, or certification</h3>
          <p>
            Tests evidence and controls under the reviewer’s professional, regulatory,
            contractual, or accreditation requirements.
          </p>
          <p>
            The reviewer decides the opinion, report, certification, authorization, score,
            or finding. Canonical Plus does not pre-approve that result.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="section bg-noise">
    <div class="container" style="position: relative; z-index: 1;">
      <header class="section-header">
        <span class="badge">Assessment flow</span>
        <h2>Five reviewable phases</h2>
        <p>
          Each phase records assumptions and dependencies so a future reviewer can understand
          how the readiness position was reached.
        </p>
      </header>

      <div class="process-list">
        <article class="process-step">
          <div>
            <h3>Business and framework fit</h3>
            <p>Clarify customer demands, contractual obligations, regulated data, public-sector goals, and timing.</p>
          </div>
        </article>
        <article class="process-step">
          <div>
            <h3>System and data boundary</h3>
            <p>Define products, cloud services, identities, code paths, vendors, data flows, and explicit exclusions.</p>
          </div>
        </article>
        <article class="process-step">
          <div>
            <h3>Control and evidence review</h3>
            <p>Map current practices to requirements and assess design, operation, evidence quality, and ownership.</p>
          </div>
        </article>
        <article class="process-step">
          <div>
            <h3>Risk-based remediation</h3>
            <p>Sequence foundational and dependent work, define acceptance criteria, and track exceptions without hiding them.</p>
          </div>
        </article>
        <article class="process-step">
          <div>
            <h3>Independent-review preparation</h3>
            <p>Prepare a scope memo, control map, evidence index, open-issues log, and responsibility matrix for handoff.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <header class="section-header section-header--center">
        <span class="badge">Typical deliverables</span>
        <h2>Artifacts that survive beyond a slide deck</h2>
        <p>
          Exact deliverables depend on scope. The following are planning targets,
          not promises of audit outcome or certification.
        </p>
      </header>

      <div class="card-grid card-grid--three">
        {deliverables.map(([name, description]) => (
          <article class="deliverable">
            <strong>{name}</strong>
            <p>{description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-panel">
        <span class="badge">Choose the right approach</span>
        <h2>Combine readiness, automation, and independent review where each adds value</h2>
        <p>
          Some teams need technical remediation help; others need continuous evidence automation;
          others are ready to appoint an independent reviewer. The right answer can be a combination.
        </p>
        <div class="action-row">
          <a href={compareHref} class="btn btn--secondary btn--large">Compare approaches</a>
          <a href={quoteHref} class="btn btn--primary btn--large" data-application-link="quote">
            Start readiness assessment
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .readiness-pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-lg);
  }

  .readiness-pricing-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .readiness-pricing-card--featured {
    border-color: var(--av-teal);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--av-teal) 35%, transparent), var(--shadow-md);
  }

  .readiness-pricing-card__number {
    color: var(--av-teal);
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .readiness-pricing-card__price {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    margin: 0;
  }

  .readiness-pricing-card__price strong {
    color: var(--av-text-primary);
    font-size: clamp(1.8rem, 4vw, 2.6rem);
  }

  .readiness-pricing-card__price span {
    color: var(--av-text-secondary);
  }

  .readiness-pricing-actions {
    justify-content: center;
    margin-top: var(--space-xl);
  }

  .readiness-pricing-boundary {
    max-width: 64rem;
    margin: var(--space-lg) auto 0;
    text-align: center;
  }

  @media (max-width: 900px) {
    .readiness-pricing-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
