---
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Canonical Plus helps software teams assess compliance readiness, prioritize remediation, and prepare evidence for independent audits and certifications.",
} = Astro.props;

const baseNoSlash = import.meta.env.BASE_URL.replace(/\/+$/, '');
const homeHref = `${baseNoSlash}/`;
const readinessHref = `${baseNoSlash}/readiness/`;
const frameworksHref = `${baseNoSlash}/frameworks/`;
const compareHref = `${baseNoSlash}/compare/`;
const processHref = `${homeHref}#process`;
const faviconHref = `${baseNoSlash}/favicon.svg`;
const themeInitScriptHref = `${baseNoSlash}/theme-init.js`;
const siteScriptHref = `${baseNoSlash}/site.js`;
const quoteHref = 'https://app.canonical.plus/u/readiness';
---

<!doctype html>
<html lang="en" data-theme="dark" data-theme-preference="auto">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#0a0f1a" id="theme-color" />
    <link rel="icon" type="image/svg+xml" href={faviconHref} />
    <title>{title} | canonical.plus</title>

    <meta property="og:title" content={`${title} | canonical.plus`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Canonical Plus" />
    <meta name="twitter:card" content="summary" />
    <script src={themeInitScriptHref}></script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <nav class="nav" id="main-nav" aria-label="Primary navigation">
      <div class="nav__inner container">
        <a href={homeHref} class="nav__logo" id="nav-logo" aria-label="Canonical Plus home">
          <svg class="nav__logo-icon" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
            <g class="brand-mark__primary" stroke="currentColor" stroke-width="9.5" stroke-linecap="round">
              <path d="M8.55 25.36A21.5 21.5 0 0 1 22.36 11.55"/>
              <path d="M35.64 11.55A21.5 21.5 0 0 1 44.98 17.62"/>
            </g>
            <g class="brand-mark__secondary" stroke="currentColor" stroke-width="9.5" stroke-linecap="round">
              <path d="M44.98 46.38A21.5 21.5 0 0 1 35.64 52.45"/>
              <path d="M22.36 52.45A21.5 21.5 0 0 1 8.55 38.64"/>
            </g>
            <g class="brand-mark__primary" fill="currentColor">
              <rect x="40.5" y="28.25" width="18" height="7.5" rx="2.5"/>
              <rect x="45.75" y="23" width="7.5" height="18" rx="2.5"/>
            </g>
          </svg>
          <span class="nav__logo-text">
            <span class="nav__logo-aardvark">CANONICAL</span><span class="nav__logo-compliance">.PLUS</span>
          </span>
        </a>

        <div class="nav__links" id="nav-links">
          <a href={readinessHref} class="nav__link" id="nav-services">Readiness</a>
          <a href={processHref} class="nav__link" id="nav-process">Process</a>
          <a href={frameworksHref} class="nav__link" id="nav-frameworks">Frameworks</a>
          <a href={compareHref} class="nav__link" id="nav-about">Compare</a>
          <a href={quoteHref} class="nav__link" id="nav-sign-in" data-application-link="sign-in">Sign in</a>
          <a href={quoteHref} class="btn btn--primary nav__cta" id="nav-quote" data-application-link="quote">Start readiness assessment</a>
        </div>

        <div class="nav__actions">
          <div class="theme-switcher theme-switcher--header" data-theme-switcher>
            <span class="sr-only">Appearance</span>
            <div class="theme-switcher__options" role="group" aria-label="Choose color theme">
              <button type="button" class="theme-switcher__option" data-theme-choice="auto" aria-label="Use local time theme" title="Auto · follows your local time">A</button>
              <button type="button" class="theme-switcher__option" data-theme-choice="light" aria-label="Use light theme" title="Light theme">L</button>
              <button type="button" class="theme-switcher__option" data-theme-choice="medium" aria-label="Use medium theme" title="Medium theme">M</button>
              <button type="button" class="theme-switcher__option" data-theme-choice="dark" aria-label="Use dark theme" title="Dark theme">D</button>
            </div>
          </div>

          <button
            class="nav__mobile-toggle"
            id="nav-toggle"
            type="button"
            aria-controls="nav-links"
            aria-expanded="false"
            aria-label="Open navigation"
          >
            <span></span>
            <span></span>
            <span></span>
          </button>
        </div>
      </div>
    </nav>

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <footer class="footer" id="site-footer">
      <div class="container">
        <div class="footer__boundary">
          <strong>Readiness, not independent assurance.</strong>
          <span>
            Canonical Plus helps scope frameworks, identify gaps, plan remediation, and prepare evidence.
            Independent auditors, assessors, certification bodies, regulators, and legal counsel make formal determinations.
          </span>
        </div>

        <div class="footer__top">
          <div class="footer__brand">
            <a href={homeHref} class="nav__logo" aria-label="Canonical Plus home">
              <svg class="nav__logo-icon" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                <g class="brand-mark__primary" stroke="currentColor" stroke-width="9.5" stroke-linecap="round">
                  <path d="M8.55 25.36A21.5 21.5 0 0 1 22.36 11.55"/>
                  <path d="M35.64 11.55A21.5 21.5 0 0 1 44.98 17.62"/>
                </g>
                <g class="brand-mark__secondary" stroke="currentColor" stroke-width="9.5" stroke-linecap="round">
                  <path d="M44.98 46.38A21.5 21.5 0 0 1 35.64 52.45"/>
                  <path d="M22.36 52.45A21.5 21.5 0 0 1 8.55 38.64"/>
                </g>
                <g class="brand-mark__primary" fill="currentColor">
                  <rect x="40.5" y="28.25" width="18" height="7.5" rx="2.5"/>
                  <rect x="45.75" y="23" width="7.5" height="18" rx="2.5"/>
                </g>
              </svg>
              <span class="nav__logo-text">
                <span class="nav__logo-aardvark">CANONICAL</span><span class="nav__logo-compliance">.PLUS</span>
              </span>
            </a>
            <p class="footer__tagline">
              Compliance readiness and technical remediation planning for software and cloud teams.
            </p>
          </div>

          <nav class="footer__columns" aria-label="Footer navigation">
            <div class="footer__col">
              <h4 class="footer__col-title">Readiness</h4>
              <a href={readinessHref} class="footer__link">Readiness assessment</a>
              <a href={processHref} class="footer__link">How it works</a>
              <a href={quoteHref} class="footer__link" data-application-link="quote">Start an assessment</a>
            </div>
            <div class="footer__col">
              <h4 class="footer__col-title">Coverage</h4>
              <a href={frameworksHref} class="footer__link">Framework catalog</a>
              <a href={compareHref} class="footer__link">Compare approaches</a>
              <a href={`${homeHref}#services`} class="footer__link">What we deliver</a>
            </div>
            <div class="footer__col">
              <h4 class="footer__col-title">Account</h4>
              <a href={quoteHref} class="footer__link" data-application-link="sign-in">Sign in</a>
              <a href={quoteHref} class="footer__link" data-application-link="quote">Readiness quote</a>
            </div>
            <div class="footer__col">
              <h4 class="footer__col-title">Contact</h4>
              <a href="mailto:compliance@canonical.cloud" class="footer__link">compliance@canonical.cloud</a>
              <a href={homeHref} class="footer__link">Canonical Plus</a>
            </div>
          </nav>
        </div>

        <div class="footer__theme theme-switcher" data-theme-switcher>
          <div>
            <p class="footer__theme-title">Choose your viewing mode</p>
            <p class="footer__theme-copy">
              Auto follows your browser's local time: light by day, medium around dawn and dusk, and dark at night.
              <span data-theme-status aria-live="polite">Auto · local time</span>
            </p>
          </div>
          <div class="theme-switcher__options theme-switcher__options--labeled" role="group" aria-label="Choose footer color theme">
            <button type="button" class="theme-switcher__option" data-theme-choice="auto">Auto</button>
            <button type="button" class="theme-switcher__option" data-theme-choice="light">Light</button>
            <button type="button" class="theme-switcher__option" data-theme-choice="medium">Medium</button>
            <button type="button" class="theme-switcher__option" data-theme-choice="dark">Dark</button>
          </div>
        </div>

        <div class="footer__bottom">
          <p class="footer__copy">&copy; {new Date().getFullYear()} canonical.plus. All rights reserved.</p>
          <p class="footer__copy">No audit opinion, certification, authorization, or legal conclusion is promised by this site.</p>
        </div>
      </div>
    </footer>

    <style>
      .skip-link {
        position: fixed;
        top: var(--space-sm);
        left: var(--space-sm);
        z-index: 2000;
        padding: 0.75rem 1rem;
        border-radius: var(--radius-sm);
        background: var(--av-text-primary);
        color: var(--av-black);
        font-weight: 700;
        transform: translateY(calc(-100% - var(--space-xl)));
        transition: transform var(--duration-fast) var(--ease-out);
      }

      .skip-link:focus-visible {
        transform: translateY(0);
      }

      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }

      #main-content:focus-visible {
        outline-offset: -3px;
      }

      :global([id]:target) {
        scroll-margin-top: calc(var(--nav-height) + var(--space-md));
      }

      .nav {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 1000;
        height: var(--nav-height);
        background: var(--av-nav-bg);
        backdrop-filter: blur(20px) saturate(180%);
        -webkit-backdrop-filter: blur(20px) saturate(180%);
        border-bottom: 1px solid var(--av-border);
        transition:
          background-color var(--duration-normal) var(--ease-out),
          border-color var(--duration-normal) var(--ease-out),
          box-shadow var(--duration-normal) var(--ease-out);
      }

      .nav.nav--scrolled {
        border-bottom-color: var(--av-nav-border-scrolled);
        box-shadow: var(--shadow-sm);
      }

      .nav__inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 100%;
      }

      .nav__logo {
        display: flex;
        align-items: center;
        gap: 10px;
      }

      .nav__logo-icon {
        width: 32px;
        height: 32px;
        flex: 0 0 auto;
      }

      .brand-mark__primary {
        color: var(--av-emerald);
      }

      .brand-mark__secondary {
        color: var(--av-teal);
      }

      .nav__logo-text {
        font-size: 0.95rem;
        font-weight: 700;
        letter-spacing: 0.1em;
      }

      .nav__logo-aardvark {
        color: var(--av-text-primary);
      }

      .nav__logo-compliance {
        color: var(--av-teal);
      }

      .nav__links {
        display: flex;
        align-items: center;
        gap: var(--space-lg);
      }

      .nav__link {
        font-size: 0.9rem;
        font-weight: 500;
        color: var(--av-text-secondary);
        transition: color var(--duration-fast) var(--ease-out);
        position: relative;
      }

      .nav__link::after {
        content: '';
        position: absolute;
        bottom: -4px;
        left: 0;
        width: 0;
        height: 2px;
        background: var(--av-teal);
        transition: width var(--duration-normal) var(--ease-out);
      }

      .nav__link:hover {
        color: var(--av-text-primary);
      }

      .nav__link:hover::after {
        width: 100%;
      }

      .nav__cta {
        padding: 0.5rem 1.15rem;
        font-size: 0.82rem;
        white-space: nowrap;
      }

      .nav__actions {
        display: flex;
        align-items: center;
        gap: var(--space-sm);
        margin-left: var(--space-md);
      }

      .theme-switcher__options {
        display: inline-flex;
        align-items: center;
        gap: 3px;
        padding: 3px;
        border: 1px solid var(--av-border-hover);
        border-radius: var(--radius-full);
        background: var(--av-switcher-bg);
        box-shadow: inset 0 1px 0 var(--av-highlight);
      }

      .theme-switcher__option {
        min-width: 2rem;
        min-height: 2rem;
        padding: 0.35rem 0.55rem;
        border-radius: var(--radius-full);
        color: var(--av-text-muted);
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.04em;
        line-height: 1;
        transition:
          color var(--duration-fast) var(--ease-out),
          background-color var(--duration-fast) var(--ease-out),
          box-shadow var(--duration-fast) var(--ease-out),
          transform var(--duration-fast) var(--ease-out);
      }

      .theme-switcher__option:hover {
        color: var(--av-text-primary);
        background: var(--av-surface-hover);
      }

      .theme-switcher__option[aria-pressed='true'] {
        color: var(--av-theme-active-text);
        background: var(--av-theme-active-bg);
        box-shadow: var(--shadow-sm);
      }

      .theme-switcher__option:active {
        transform: scale(0.96);
      }

      .nav__mobile-toggle {
        display: none;
        flex-direction: column;
        gap: 5px;
        padding: 11px;
        min-height: 44px;
        min-width: 44px;
      }

      .nav__mobile-toggle span {
        display: block;
        width: 22px;
        height: 2px;
        background: var(--av-text-secondary);
        border-radius: 2px;
      }

      .footer {
        border-top: 1px solid var(--av-border);
        padding: var(--space-3xl) 0 var(--space-xl);
        background: var(--av-footer-bg);
      }

      .footer__boundary {
        display: grid;
        grid-template-columns: minmax(12rem, 0.45fr) 1.55fr;
        gap: var(--space-lg);
        padding: var(--space-lg);
        margin-bottom: var(--space-3xl);
        border: 1px solid var(--av-border-active);
        border-radius: var(--radius-md);
        background: var(--av-emerald-glow);
        color: var(--av-text-secondary);
      }

      .footer__boundary strong {
        color: var(--av-text-primary);
      }

      .footer__top {
        display: flex;
        justify-content: space-between;
        gap: var(--space-4xl);
        margin-bottom: var(--space-3xl);
      }

      .footer__brand {
        max-width: 320px;
      }

      .footer__tagline {
        margin-top: var(--space-md);
        font-size: 0.95rem;
        color: var(--av-text-muted);
        line-height: 1.6;
      }

      .footer__columns {
        display: flex;
        gap: var(--space-3xl);
      }

      .footer__col {
        display: flex;
        flex-direction: column;
        gap: var(--space-sm);
      }

      .footer__col-title {
        font-size: 0.85rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--av-text-primary);
        margin-bottom: var(--space-sm);
      }

      .footer__link {
        font-size: 0.9rem;
        color: var(--av-text-muted);
        transition: color var(--duration-fast) var(--ease-out);
      }

      .footer__link:hover {
        color: var(--av-teal);
      }

      .footer__bottom {
        display: flex;
        justify-content: space-between;
        gap: var(--space-lg);
        align-items: center;
        padding-top: var(--space-xl);
        border-top: 1px solid var(--av-border);
      }

      .footer__theme {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: var(--space-xl);
        padding: var(--space-lg) 0;
        border-top: 1px solid var(--av-border);
      }

      .footer__theme-title {
        color: var(--av-text-primary);
        font-size: 0.9rem;
        font-weight: 700;
      }

      .footer__theme-copy {
        margin-top: 0.2rem;
        color: var(--av-text-muted);
        font-size: 0.8rem;
      }

      .footer__theme-copy [data-theme-status] {
        color: var(--av-teal);
        white-space: nowrap;
      }

      .theme-switcher__options--labeled .theme-switcher__option {
        min-width: auto;
        padding-inline: 0.8rem;
      }

      .footer__copy {
        max-width: 42rem;
        font-size: 0.8rem;
        color: var(--av-text-muted);
      }

      @media (max-width: 900px) {
        .nav__links {
          gap: var(--space-md);
        }

        .nav__cta {
          display: none;
        }

        .footer__top {
          flex-direction: column;
          gap: var(--space-2xl);
        }

        .footer__columns {
          flex-wrap: wrap;
          gap: var(--space-2xl);
        }

        .footer__theme {
          align-items: flex-start;
          flex-direction: column;
        }
      }

      @media (max-width: 768px) {
        .nav__links {
          display: none;
        }

        .nav .nav__links.nav__links--open {
          position: absolute;
          top: var(--nav-height);
          left: 0;
          right: 0;
          display: flex;
          flex-direction: column;
          align-items: stretch;
          gap: 0;
          padding: var(--space-md);
          background: var(--av-nav-bg-strong);
          border-bottom: 1px solid var(--av-border);
        }

        .nav .nav__links.nav__links--open .nav__link,
        .nav .nav__links.nav__links--open .nav__cta {
          display: flex;
          min-height: 44px;
          align-items: center;
          padding: 0.75rem;
        }

        .nav__mobile-toggle {
          display: flex;
        }

        .footer__boundary {
          grid-template-columns: 1fr;
        }

        .footer__bottom {
          flex-direction: column;
          text-align: center;
        }

        .theme-switcher__options--labeled {
          width: 100%;
        }

        .theme-switcher__options--labeled .theme-switcher__option {
          flex: 1;
        }
      }

      @media (max-width: 480px) {
        .nav > .nav__inner > .nav__logo .nav__logo-text {
          display: none;
        }

        .nav__actions {
          margin-left: 0;
        }
      }
    </style>

    <script type="module" src={siteScriptHref}></script>
  </body>
</html>
